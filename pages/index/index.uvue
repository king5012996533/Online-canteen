<template>
	<view class="page">
		<!-- ===== 绿色头部：定位 + 今天吃什么 + 餐次选择 + 配送条件 ===== -->
		<view class="hero-green">
			<view class="navbar">
				<view class="loc-chip" @click="openLocSheet"><text class="loc-pin">📍</text><text class="loc-text">{{locLabel}}</text><text class="loc-arr">▾</text></view>
			</view>
			<text class="home-h1">今天吃什么？</text>
			<text class="home-sub">今日菜单</text>
			<view class="meal-chips">
				<view class="meal-chip" :class="{'on': cartMeal === 'lunch', 'off': mealState.lunch === 'closed'}" @click="pickMeal('lunch')"><text class="meal-chip-text" :class="{'on': cartMeal === 'lunch'}">午餐</text></view>
				<view class="meal-chip" :class="{'on': cartMeal === 'dinner', 'off': mealState.dinner === 'closed'}" @click="pickMeal('dinner')"><text class="meal-chip-text" :class="{'on': cartMeal === 'dinner'}">晚餐</text></view>
			</view>
			<view class="cond">
				<view class="cond-chip"><text class="cond-text">配送时间 {{cfgOf(cartMeal).deliveryLabel}}</text></view>
				<view class="cond-chip"><text class="cond-text">下单截止 今天 {{cfgOf(cartMeal).orderCloseLabel}}</text></view>
			</view>
		</view>

		<!-- ===== 米白菜单面板 ===== -->
		<scroll-view class="menu-panel" scroll-y="true">
			<text v-if="loading" class="g-sub menu-state">正在加载今日菜单…</text>
			<text v-else-if="dishes.length === 0" class="g-sub menu-state">今日菜单还没发布，早点来看看</text>
			<view v-for="category in categories" :key="category" class="category">
				<view class="cat-head"><text class="cat-title">{{category}}</text><text class="cat-more">查看更多</text></view>
				<view v-for="dish in dishesByCategory(category)" :key="dish.id" class="dish-row" :class="{sold: dish.sold}">
					<image class="dish-thumb" :src="dish.image" mode="aspectFill"></image>
					<view class="dish-info">
						<text class="dish-name">{{dish.name}}</text>
						<view class="dish-price-line"><text class="dish-price">¥{{dish.price}}</text><text v-if="dish.custom" class="dish-qi"> 起</text></view>
					</view>
					<view v-if="dish.sold" class="sold-chip"><text class="sold-text">已售罄</text></view>
					<view v-else class="add-btn" @click="openDish(dish)"><text class="add-plus">＋</text></view>
				</view>
			</view>
			<view class="admin-entry" @click="goAdmin"><text class="g-sub">厨房端 ›</text></view>
		</scroll-view>

		<!-- ===== 菜品详情（自由定价） ===== -->
		<view v-if="screen === 'dish' && selDish !== null" class="dish-page">
			<view class="detail-hero">
				<image class="hero-img" :src="heroImg" mode="aspectFill"></image>
				<view class="detail-nav">
					<view class="dn-btn" @click="screen = 'menu'"><text class="dn-arr">‹</text></view>
					<text class="tt">菜品详情</text>
					<view class="dn-btn"><text class="dn-dots">•••</text></view>
				</view>
			</view>
			<view class="detail-body">
				<text class="detail-title">{{selDish?.name}}</text>
				<text class="detail-min">最低售价 <text class="detail-min-green">¥{{selDish?.price}}</text></text>
				<text class="detail-desc">{{selDish?.desc}}</text>
				<view class="price-panel" v-if="isCustomDish">
					<text class="pt">每道菜都有最低售价</text>
					<text class="pd">你可以根据自己的食量自由调整价格，吃多少付多少。</text>
					<view class="tiers">
						<view class="tier" :class="{'sel': sliderVal === tier1}"><text class="tv">¥{{tier1}}</text><text class="tl">基础份量</text></view>
						<view class="tier" :class="{'sel': sliderVal === tier2}"><text class="tv">¥{{tier2}}</text><text class="tl">加量</text></view>
						<view class="tier" :class="{'sel': sliderVal === tier3}"><text class="tv">¥{{tier3}}</text><text class="tl">更足</text></view>
					</view>
				</view>
				<view class="price-panel" v-else>
					<view class="fixed-row"><text class="pt">单价</text><text class="fixed-price">¥{{selDish?.price}}</text></view>
					<view class="fixed-qty-row"><text class="pd">数量</text>
						<view class="stepper"><view class="step-b minus" @click="decDetailQty"><text class="step-char">−</text></view><text class="step-n">{{detailQty}}</text><view class="step-b" @click="incDetailQty"><text class="step-char">＋</text></view></view>
					</view>
				</view>
				<view class="slider-block" v-if="isCustomDish">
					<text class="slider-title">选择您愿意支付的金额</text>
					<slider class="the-slider" :min="sliderMin" :max="sliderMax" :step="1" :value="sliderVal" activeColor="#2F6B3F" backgroundColor="#E7E3D6" block-size="22" block-color="#2F6B3F" @change="onSlider"></slider>
					<view class="slider-ticks"><text class="tick" :class="{'on': sliderVal === tier1}">¥{{tier1}}</text><text class="tick" :class="{'on': sliderVal === tier2}">¥{{tier2}}</text><text class="tick" :class="{'on': sliderVal === tier3}">¥{{tier3}}</text><text class="tick">¥{{sliderMax}}+</text></view>
				</view>
				<view class="choice" v-if="isCustomDish">
					<view class="cl"><text class="cl-l">你选择：</text><text class="cl-v">¥{{sliderVal}}</text></view>
					<text class="cr">预计份量：{{portionLabel}}</text>
				</view>
			</view>
			<view class="cta" @click="addFromDetail"><text class="cta-text">加入饭盒</text></view>
		</view>

		<!-- 配送地点选择弹层 -->
		<view v-if="locSheet" class="sheet-mask"><view class="sheet">
			<text class="sheet-title">配送地点</text>
			<text class="g-sub">餐做好后送到这个位置，下单时自动使用</text>
			<input class="g-field-input price-input" v-model="locInput" placeholder="如：XX大厦 / 公司前台" placeholder-class="g-ph" />
			<button class="g-btn-primary cta" @click="saveLocSheet">保存</button>
			<button class="g-btn-ghost cta" @click="locSheet = false">取消</button>
		</view></view>
	</view>
</template>

<script setup lang="uts">
	import { requestJson } from '../../common/http.uts'
	import { cfgOf } from '../../common/meals.uts'
	import { cartHydrate, cartItems, cartMeal, cartAdd, cartCount, cartSetMeal, cartSyncBadge } from '../../common/cart.uts'
	import { customer, sessionSilentLogin, sessionSaveProfile } from '../../common/session.uts'

	type Dish = { id: string; category: string; name: string; desc: string; price: number; pay: number; qty: number; custom: boolean; sold: boolean; image: string }

	// 【测试开关】true = 暂时解除两餐截单限制，随时可下测试单。
	// 与 cf-api 里的 BYPASS_CUTOFF 配套；正式上线前两处都要关掉！
	const testBypass = true

	const screen = ref('home') // home / menu / dish
	const loading = ref(false)
	const dateLabel = ref('')
	const toastMessage = ref('')
	const categories = ['素菜', '荤素搭配', '纯荤']
	const dishes = ref<Dish[]>([])
	const selDish = ref<Dish | null>(null)
	const sliderMin = ref(9)
	const sliderMax = ref(25)
	const sliderVal = ref(12)
	const detailQty = ref(1)
	const locSheet = ref(false)
	const locInput = ref('')

	// 餐次状态：open 可点单 / cooking 制作中 / ready 可取餐 / closed 已收档
	const mealState = reactive({ lunch: 'open', dinner: 'open' })
	function stateOf(key: string): string { return key === 'dinner' ? mealState.dinner : mealState.lunch }
	function setMealState(key: string, s: string) { if (key === 'dinner') { mealState.dinner = s } else { mealState.lunch = s } }
	function isMealOpen(key: string): boolean { if (testBypass) return true; return stateOf(key) === 'open' }

	const locLabel = computed((): string => { const loc = customer.location.trim(); if (loc === '') return '公司前台'; return loc })
	const heroImg = computed((): string => { const d = selDish.value; return d !== null ? d.image : '' })
	const portionLabel = computed((): string => {
		if (selDish.value === null) return '基础份量'
		const base = selDish.value.price
		const v = sliderVal.value
		if (v <= base) return '基础份量'
		if (v <= Math.round(base * 1.34)) return '比基础份量多一点'
		if (v <= Math.round(base * 1.67)) return '比基础份量更多'
		return '非常充足'
	})
	const tier1 = computed((): number => { return selDish.value !== null ? selDish.value.price : 0 })
	const tier2 = computed((): number => { return selDish.value !== null ? Math.round(selDish.value.price * 1.34) : 0 })
	const tier3 = computed((): number => { return selDish.value !== null ? Math.round(selDish.value.price * 1.67) : 0 })
	const isCustomDish = computed((): boolean => { return selDish.value !== null && selDish.value.custom })

	function dishesByCategory(category: string): Dish[] { return dishes.value.filter((dish) => dish.category === category) }
	function toast(msg: string) { toastMessage.value = msg; setTimeout(() => { toastMessage.value = '' }, 1800) }
	function pad2(n: number): string { return n < 10 ? '0' + n : '' + n }

	function updateMealState(key: string, min: number) {
		const c = cfgOf(key)
		let s = 'closed'
		if (min < c.closeMin) { if (min < c.orderCloseMin) { s = 'open' } else if (min < c.readyMin) { s = 'cooking' } else { s = 'ready' } }
		setMealState(key, s)
	}
	function tick() {
		const now = new Date(Date.now() + (480 + new Date().getTimezoneOffset()) * 60000)
		const min = now.getUTCHours() * 60 + now.getUTCMinutes()
		updateMealState('lunch', min)
		updateMealState('dinner', min)
		// 当前餐次收档且饭盒为空时，自动切到另一餐
		if (stateOf(cartMeal.value) === 'closed' && cartCount() === 0) {
			const other = cartMeal.value === 'lunch' ? 'dinner' : 'lunch'
			if (stateOf(other) !== 'closed') { cartSetMeal(other) }
		}
	}

	// 餐次切换：饭盒非空时拒绝换餐
	function pickMeal(key: string) {
		if (key === cartMeal.value) return
		if (!cartSetMeal(key)) { toast('饭盒里已有' + cfgOf(cartMeal.value).label + '的菜品，请先结算或清空'); return }
	}

	// 菜单指纹：id+菜名+价格+售罄，用于判断厨房端是否发布过新菜单
	function menuSignature(list: Dish[]): string {
		let s = ''
		list.forEach((d: Dish) => { s += d.id + ':' + d.name + ':' + d.price + ':' + (d.sold ? '1' : '0') + '|' })
		return s
	}
	// silent=true：页面重新显示时的静默刷新（不转圈、失败不弹错），并保留已选数量
	async function loadMenu(silent: boolean) {
		if (!silent) loading.value = true
		try {
			const result = await requestJson('/cf-menu', { action: 'getToday' } as UTSJSONObject)
			if (result !== null && result.getBoolean('ok') === true) {
				const data = result.getJSON('data')
				if (data instanceof UTSJSONObject) {
					dateLabel.value = data.getString('dateLabel') ?? ''
					const arr = data.getArray('dishes')
					const list: Dish[] = []
					if (arr !== null) {
						for (let i = 0; i < arr.length; i++) {
							const o = arr[i]
							if (o instanceof UTSJSONObject) {
								const base = o.getNumber('basePrice') ?? 0
								list.push({ id: o.getString('id') ?? '', category: o.getString('category') ?? '', name: o.getString('name') ?? '', desc: o.getString('desc') ?? '', price: base, pay: base, qty: 0, custom: o.getBoolean('canCustomPrice') === true, sold: o.getBoolean('soldOut') === true, image: o.getString('image') ?? '' })
							}
						}
					}
					// 已在饭盒里的菜保留数量/定价；新菜、改价、删除的按默认处理
					const oldList = dishes.value
					for (let i = 0; i < list.length; i++) {
						const nd = list[i]
						const inCart = cartItems.value.find((x) => x.id === nd.id)
						if (inCart !== null && inCart.pay >= nd.price) { nd.pay = inCart.pay }
					}
					const changed = silent && menuSignature(oldList) !== menuSignature(list)
					dishes.value = list
					if (changed) { toast('菜单已更新') }
				}
			} else if (!silent) { toast('今日菜单加载失败，请稍后再试') }
		} catch (e) { if (!silent) toast('网络异常，请检查网络后重试') }
		if (!silent) loading.value = false
	}
	function goAdmin() { uni.navigateTo({ url: '/pages/admin/admin' }) }
	// 定位胶囊：弹出配送地点选择/输入（与个人中心无关）
	function openLocSheet() { locInput.value = customer.location; locSheet.value = true }
	function saveLocSheet() {
		const v = locInput.value.trim()
		if (v === '') { toast('请输入配送地点'); return }
		customer.location = v
		locSheet.value = false
		toast('配送地点已更新')
		sessionSaveProfile()
	}
	// 固定价菜：快速 +1 入饭盒
	function quickAdd(dish: Dish) {
		if (!isMealOpen(cartMeal.value)) { toast(cfgOf(cartMeal.value).label + '已截单，请改点另一餐'); return }
		cartAdd({ id: dish.id, name: dish.name, image: dish.image, pay: dish.price, qty: 1, spec: '标准' })
		toast('已加入饭盒')
	}
	// 统一加购入口：进入菜品详情，自定义价菜走定价滑杆，固定价菜选数量
	function openDish(dish: Dish) {
		if (!isMealOpen(cartMeal.value)) { toast(cfgOf(cartMeal.value).label + '已截单，请改点另一餐'); return }
		selDish.value = dish
		sliderMin.value = dish.price
		sliderMax.value = Math.round(dish.price * 2.5)
		sliderVal.value = Math.round(dish.price * 1.34)
		detailQty.value = 1
		screen.value = 'dish'
	}
	function onSlider(e: SliderChangeEvent) { sliderVal.value = Math.floor(e.detail.value) }
	function incDetailQty() { detailQty.value += 1 }
	function decDetailQty() { if (detailQty.value > 1) { detailQty.value -= 1 } }
	// 加入饭盒：自定义价菜按滑杆价 1 份；固定价菜按所选数量
	function addFromDetail() {
		const dish = selDish.value
		if (dish === null) return
		if (!isMealOpen(cartMeal.value)) { toast(cfgOf(cartMeal.value).label + '已截单，请改点另一餐'); return }
		if (dish.custom) {
			if (sliderVal.value < dish.price) { toast('价格不能低于最低售价'); return }
			const spec = sliderVal.value <= tier1.value ? '标准' : (sliderVal.value <= tier2.value ? '加量' : '更足')
			cartAdd({ id: dish.id, name: dish.name, image: dish.image, pay: sliderVal.value, qty: 1, spec: spec })
		} else {
			cartAdd({ id: dish.id, name: dish.name, image: dish.image, pay: dish.price, qty: detailQty.value, spec: '标准' })
		}
		toast('已加入饭盒')
		screen.value = 'menu'
	}
	// 首次进入：正常加载（带 loading 转圈）
	let firstShow = true
	// 每次页面显示（含切回本 Tab）都静默刷新菜单：厨房端发布菜单后立即生效
	onShow(() => {
		cartHydrate()
		cartSyncBadge()
		loadMenu(!firstShow)
		firstShow = false
	})
	// 首次进入时静默登录并回填常用信息（失败不打扰点单，仅记日志）
	onLoad(() => { sessionSilentLogin() })
	tick()
	const tickTimer = setInterval(tick, 1000)
	// 页面销毁时清理计时器，避免叠加多个定时器
	onUnload(() => { clearInterval(tickTimer) })
</script>

<style>
	.page { flex: 1; background-color: #F6F3EB; }
	/* ---------- 绿色头部 ---------- */
	.hero-green { background-color: #2F6B3F; padding: 10px 20px 18px; }
	.navbar { display: flex; flex-direction: row; align-items: center; padding: 2px 0 10px; }
	.loc-chip { display: flex; flex-direction: row; align-items: center; }
	.loc-pin { font-size: 13px; margin-right: 4px; }
	.loc-text { color: #FFFFFF; font-size: 14px; font-weight: 800; }
	.loc-arr { color: rgba(255,255,255,.7); font-size: 10px; margin-left: 4px; }
	.home-h1 { display: block; color: #FFFFFF; font-size: 26px; font-weight: 900; }
	.home-sub { display: block; color: rgba(255,255,255,.72); font-size: 12px; font-weight: 600; margin-top: 4px; }
	.meal-chips { display: flex; flex-direction: row; margin-top: 12px; }
	.meal-chip { border: 1px solid rgba(255,255,255,.45); border-radius: 999px; padding: 6px 16px; margin-right: 8px; background-color: rgba(255,255,255,.12); }
	.meal-chip.on { background-color: #FFFFFF; border-color: #FFFFFF; }
	.meal-chip.off { opacity: 0.5; }
	.meal-chip-text { font-size: 12.5px; font-weight: 700; color: rgba(255,255,255,.85); }
	.meal-chip-text.on { color: #2F6B3F; font-weight: 800; }
	.cond { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
	.cond-chip { background-color: #E9F1E7; border-radius: 10px; padding: 7px 10px; margin: 0 8px 0 0; }
	.cond-text { font-size: 10.5px; color: #24522F; font-weight: 700; }
	/* ---------- 菜单面板 ---------- */
	.menu-panel { flex: 1; background-color: #F6F3EB; border-radius: 20px 20px 0 0; margin-top: 14px; padding: 8px 20px 30px; }
	.menu-state { display: block; text-align: center; padding: 24px 0; }
	.cat-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin: 16px 0 4px; }
	.cat-title { font-size: 15px; font-weight: 900; color: #24522F; }
	.cat-more { font-size: 10.5px; color: #8C9689; }
	.dish-row { display: flex; flex-direction: row; align-items: center; padding: 11px 0; border-bottom: 1px solid #E7E3D6; }
	.dish-thumb { width: 62px; height: 62px; border-radius: 12px; background-color: #EFE9DC; flex-shrink: 0; margin-right: 12px; }
	.dish-info { flex: 1; min-width: 0; margin-right: 8px; }
	.dish-name { display: block; font-size: 14.5px; font-weight: 800; color: #22301F; }
	.dish.sold .dish-name { color: #8C9689; }
	.dish-price-line { display: flex; flex-direction: row; align-items: baseline; margin-top: 3px; }
	.dish-price { font-size: 15px; font-weight: 900; color: #24522F; }
	.dish-qi { font-size: 10px; color: #8C9689; }
	.add-btn { width: 30px; height: 30px; border-radius: 15px; background-color: #2F6B3F; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
	.add-plus { color: #FFFFFF; font-size: 17px; line-height: 17px; margin-top: -2px; }
	.stepper { display: flex; flex-direction: row; align-items: center; border: 1px solid #E7E3D6; border-radius: 999px; padding: 2px; background-color: #FFFFFF; flex-shrink: 0; }
	.step-b { width: 24px; height: 24px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
	.step-b.minus { background-color: #F3F7F1; }
	.step-char { color: #2F6B3F; font-size: 13px; line-height: 13px; font-weight: 800; }
	.step-b.minus .step-char { color: #8C9689; }
	.step-n { min-width: 24px; text-align: center; font-size: 12px; font-weight: 800; color: #22301F; }
	.sold-chip { background-color: #F3F7F1; border-radius: 6px; padding: 5px 9px; flex-shrink: 0; }
	.sold-text { color: #8C9689; font-size: 10px; font-weight: 700; }
	.admin-entry { display: flex; flex-direction: row; justify-content: center; margin-top: 18px; }
	/* ---------- 菜品详情 ---------- */
	.dish-page { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background-color: #F6F3EB; z-index: 20; display: flex; flex-direction: column; }
	.detail-hero { height: 250px; position: relative; background-color: #EFE9DC; flex-shrink: 0; }
	.hero-img { width: 100%; height: 250px; }
	.detail-nav { position: absolute; left: 0; right: 0; top: 0; display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 14px 16px; }
	.dn-btn { width: 30px; height: 30px; border-radius: 15px; background-color: rgba(0,0,0,.28); display: flex; align-items: center; justify-content: center; }
	.dn-arr { color: #FFFFFF; font-size: 18px; line-height: 18px; }
	.dn-dots { color: #FFFFFF; font-size: 11px; letter-spacing: 1px; }
	.tt { color: #FFFFFF; font-size: 15px; font-weight: 800; }
	.detail-body { flex: 1; background-color: #FFFFFF; border-radius: 18px 18px 0 0; margin-top: -16px; padding: 16px 20px 0; }
	.detail-title { display: block; font-size: 20px; font-weight: 900; color: #22301F; }
	.detail-min { display: block; font-size: 12px; color: #8C9689; margin-top: 4px; }
	.detail-min-green { color: #24522F; font-weight: 800; }
	.detail-desc { display: block; font-size: 11.5px; color: #8C9689; margin-top: 8px; line-height: 1.6; }
	.price-panel { background-color: #F3F7F1; border-radius: 14px; padding: 12px 14px; margin-top: 12px; }
	.pt { display: block; font-size: 12.5px; font-weight: 900; color: #24522F; }
	.pd { display: block; font-size: 10.5px; color: #8C9689; margin-top: 4px; line-height: 1.5; }
	.tiers { display: flex; flex-direction: row; margin-top: 10px; }
	.tier { flex: 1; background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 12px; padding: 10px 6px; align-items: center; margin-right: 8px; }
	.tier.sel { border-color: #2F6B3F; }
