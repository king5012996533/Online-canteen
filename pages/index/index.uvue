<template>
	<view class="page">
		<scroll-view class="scroll" scroll-y="true" :scroll-into-view="menuAnchor">
			<!-- 屏1 首页：品牌行 + 开火时刻轴（可切餐次）+ 双餐次入口 -->
			<view v-if="screen === 'home'" class="home-content">
				<view class="brand-row">
					<view class="brand-left"><text class="wordmark">富记</text><text class="g-cap brand-sub">FUJI 线上饭堂</text></view>
					<view class="loc-pill" @click="goProfile"><view class="loc-dot"></view><text class="loc-text">{{locLabel}}</text></view>
				</view>
				<view class="timeline">
					<view class="tl-meals">
						<view class="tl-meal-chip" :class="{'on': homeMeal === 'lunch'}" @click="homeMeal = 'lunch'"><text class="tl-meal-text" :class="{'on': homeMeal === 'lunch'}">午餐</text></view>
						<view class="tl-meal-chip" :class="{'on': homeMeal === 'dinner'}" @click="homeMeal = 'dinner'"><text class="tl-meal-text" :class="{'on': homeMeal === 'dinner'}">晚餐</text></view>
					</view>
					<view class="tl-now">
						<view class="tl-status"><view class="tl-livedot"></view><text class="tl-status-text">{{tlStatus}}</text></view>
						<text class="tl-right">{{tlRight}}</text>
					</view>
					<view class="tl-track">
						<view class="tl-done" :style="{width: tlPos + '%'}"></view>
						<view class="tl-stop" :class="{'past': tlPos > 0}" style="left: 0%"></view>
						<view class="tl-stop" :class="{'past': tlPos > 33.3}" style="left: 33.3%"></view>
						<view class="tl-stop" :class="{'past': tlPos > 66.6}" style="left: 66.6%"></view>
						<view class="tl-stop" :class="{'past': tlPos > 99}" style="left: 100%"></view>
						<view class="tl-nowdot" :style="{left: tlPos + '%'}"></view>
					</view>
					<view class="tl-labels">
						<text class="tl-label s0">{{tlL0}}</text>
						<text class="tl-label s1">{{tlL1}}</text>
						<text class="tl-label s2">{{tlL2}}</text>
						<text class="tl-label s3">{{tlL3}}</text>
					</view>
				</view>
				<view class="hero">
					<view class="hero-pic">
						<image class="hero-img" src="/static/dishes/hero.png" mode="aspectFill"></image>
						<view class="hero-chip g-chip-solid"><text class="hero-chip-text">今日现做</text></view>
					</view>
					<text class="home-h2">{{homeHeadline}}</text>
					<text class="home-sub">午晚两餐 · 后厨现炒出锅 · 大堂自取 · 免配送费</text>
				</view>
				<view class="entries">
					<view class="entry" @click="enterMeal('lunch')">
						<view class="entry-main">
							<view class="entry-title-row"><text class="entry-title">午餐</text><text class="entry-state" :class="entryStateClass('lunch')">{{entryStateText('lunch')}}</text></view>
							<text class="entry-meta">11:00 截单 · 11:30 出炉 · 13:00 收档</text>
						</view>
						<text class="entry-arrow">›</text>
					</view>
					<view class="entry" @click="enterMeal('dinner')">
						<view class="entry-main">
							<view class="entry-title-row"><text class="entry-title">晚餐</text><text class="entry-state" :class="entryStateClass('dinner')">{{entryStateText('dinner')}}</text></view>
							<text class="entry-meta">16:00 截单 · 17:30 出炉 · 19:30 收档</text>
						</view>
						<text class="entry-arrow">›</text>
					</view>
				</view>
				<view class="facts">
					<view class="g-chip-outline fact-chip"><text class="fact-text">午 · 11:00 截单</text></view>
					<view class="g-chip-outline fact-chip"><text class="fact-text">晚 · 16:00 截单</text></view>
					<view class="g-chip-outline fact-chip"><text class="fact-text">现炒现做</text></view>
					<view class="g-chip-outline fact-chip"><text class="fact-text">¥16 起送</text></view>
				</view>
				<view class="admin-entry" @click="goAdmin"><text class="g-sub">厨房端 ›</text></view>
			</view>

			<!-- 屏2 今日菜单（按餐次）：分类 chip + 白底大图菜品列表 -->
			<view v-else-if="screen === 'menu'" class="menu-content">
				<view class="menu-header">
					<view><text class="g-title">今日{{mealLabel}}</text><text class="menu-date">{{menuSub}}</text></view>
					<button class="back" @click="screen = 'home'">‹</button>
				</view>
				<view class="pills">
					<view v-for="(category, index) in categories" :key="category" class="pill" :class="{'pill-active': activePill === category}" @click="jumpCategory(category, index)"><text class="pill-text" :class="{'pill-text-active': activePill === category}">{{category}}</text></view>
				</view>
				<text v-if="loading" class="g-sub menu-state">正在加载今日菜单…</text>
				<text v-else-if="dishes.length === 0" class="g-sub menu-state">今日菜单还没发布，早点来看看</text>
				<view v-for="(category, index) in categories" :key="category" :id="'cat-' + index" class="category">
					<view class="cat-head"><text class="cat-title">{{category}}</text><text class="cat-price">¥{{minPrice(category)}} 起</text></view>
					<view v-for="dish in dishesByCategory(category)" :key="dish.id" class="dish" :class="{sold: dish.sold}">
						<view class="dish-ph">
							<image class="dish-image" :src="dish.image" mode="aspectFill"></image>
							<view v-if="dish.sold" class="dish-sold-chip"><text class="dish-sold-text">已售罄</text></view>
						</view>
						<view class="dish-main">
							<view class="dish-name-row"><text class="dish-name">{{dish.name}}</text><text v-if="dish.custom && !dish.sold" class="badge-add">可加价</text></view>
							<text class="dish-desc">{{dish.desc}}</text>
							<text class="g-price dish-price">¥{{dish.qty > 0 ? dish.pay : dish.price}}{{dish.qty > 0 && dish.pay !== dish.price ? '（已加价）' : ''}}</text>
						</view>
						<view v-if="dish.sold" class="add-btn add-dim"><text class="add-plus">＋</text></view>
						<view v-else-if="dish.qty === 0" class="add-btn" @click="changeQty(dish.id, 1)"><text class="add-plus">＋</text></view>
						<view v-else class="stepper">
							<view class="step-btn step-minus" @click="changeQty(dish.id, -1)"><text class="step-char">−</text></view>
							<text class="step-num">{{dish.qty}}</text>
							<view class="step-btn step-plus" @click="changeQty(dish.id, 1)"><text class="step-char step-char-plus">＋</text></view>
						</view>
					</view>
				</view>
			</view>

			<!-- 屏3 结算：订单小结 + 收餐信息 -->
			<view v-else-if="screen === 'check'" class="check-content">
				<view class="menu-header">
					<view><text class="g-title">确认订单 · {{mealLabel}}</text><text class="menu-date">{{checkSub}}</text></view>
					<button class="back" @click="screen = 'menu'">‹</button>
				</view>
				<view class="order-card">
					<text class="g-cap card-title">今日所点</text>
					<view v-for="dish in selectedDishes" :key="dish.id" class="order-line"><text class="order-line-name">{{dish.name}} × {{dish.qty}}</text><text class="order-line-price">¥{{dish.pay * dish.qty}}</text></view>
					<view class="order-total"><text class="order-total-label">合计</text><text class="g-price total-number">¥{{total}}</text></view>
				</view>
				<view class="form-field"><view class="form-label-row"><text class="g-label">怎么称呼您</text><text class="g-req">*</text></view><input class="g-field-input" v-model="customer.name" placeholder="如：张三 / 3 楼财务" placeholder-class="g-ph" /></view>
				<view class="form-field"><view class="form-label-row"><text class="g-label">取餐位置</text><text class="g-req">*</text></view><input class="g-field-input" v-model="customer.location" placeholder="例如：产品部 · 18F" placeholder-class="g-ph" /></view>
				<view class="form-field"><view class="form-label-row"><text class="g-label">手机号（选填）</text></view><input class="g-field-input" v-model="customer.phone" type="number" placeholder="异常联系用" placeholder-class="g-ph" /></view>
				<view class="form-field"><view class="form-label-row"><text class="g-label">备注（选填）</text></view><input class="g-field-input" v-model="customer.note" placeholder="忌口、少辣、不要香菜…" placeholder-class="g-ph" /></view>
				<view class="notice"><text class="notice-text">主食随餐附送。提交后如需取消或改动，请在 {{mealCloseLabel}} 截单前联系饭堂。</text></view>
				<button class="g-btn-primary cta" @click="goPay">提交订单 · 去支付</button>
			</view>

			<!-- 屏3.5 模拟支付（测试环境）：商户号下来后换成 wx.requestPayment -->
			<view v-else-if="screen === 'pay'" class="pay-content">
				<view class="pay-card">
					<view class="pay-merchant"><view class="pay-avatar"><text class="pay-avatar-char">富</text></view><text class="pay-merchant-name">富记线上饭堂</text></view>
					<text class="pay-amount">¥{{total}}</text>
					<text class="pay-mode">微信支付 · 模拟环境 · {{mealLabel}}</text>
				</view>
				<view class="notice"><text class="notice-text">当前为测试模式：此步不产生真实扣款。微信支付商户号开通后，这里会替换为真正的微信支付。</text></view>
				<button class="g-btn-primary cta" :disabled="submitting" @click="confirmOrder">{{submitting ? '支付中…' : '确认支付'}}</button>
				<button class="g-btn-ghost cta" @click="screen = 'check'">返回修改订单</button>
			</view>

			<!-- 屏4 成功：取餐码 + 明细 -->
			<view v-else class="success-content">
				<view class="ok-wrap">
					<view class="success-mark"><text class="success-mark-char">✓</text></view>
					<text class="success-title">{{mealLabel}}下单成功</text>
					<text class="g-sub success-note">饭堂已收到，截单后开火现炒</text>
					<view class="ticket">
						<view class="pcode-row">
							<view class="pcode-left"><text class="g-cap">取餐码</text><text class="pcode">{{pickupCode}}</text></view>
							<text class="ticket-no">NO.{{orderNumber}}</text>
						</view>
						<view class="g-hairline"></view>
						<view class="ticket-body">
							<view v-for="(line, index) in orderItems" :key="index" class="trow"><text class="trow-name">{{line.name}} × {{line.qty}}</text><text class="trow-price">¥{{line.pay * line.qty}}</text></view>
							<view class="trow"><text class="trow-name trow-name-hl">合计</text><text class="g-price trow-total">¥{{orderTotal}}</text></view>
							<view class="trow"><text class="trow-name trow-dim">取餐人</text><text class="trow-value">{{customer.name || '未填写'}}</text></view>
							<view class="trow"><text class="trow-name trow-dim">取餐位置</text><text class="trow-value">{{customer.location || '大堂'}}</text></view>
							<view class="trow"><text class="trow-name trow-dim">建议取餐</text><text class="trow-value">{{suggestPickup}}</text></view>
						</view>
					</view>
					<view class="ok-links">
						<button class="g-btn-primary ok-pri" @click="screen = 'menu'">再点一单</button>
						<button class="g-btn-ghost ok-sec" @click="toast('请到大堂前台找富记取餐')">联系饭堂</button>
					</view>
				</view>
			</view>
		</scroll-view>
		<view v-if="screen === 'menu'" class="cartbar">
			<view class="cart-pill">
				<view class="cart-left">
					<view class="cart-bubble"><text class="cart-count">{{itemCount}}</text></view>
					<view class="cart-sum">
						<text class="cart-amount">¥{{total}}</text>
						<text class="cart-hint">{{total >= 16 ? ('可结算 · ' + mealLabel) : '再点 ¥' + (16 - total) + ' 可起送'}}</text>
					</view>
				</view>
				<button class="g-btn-primary cart-go" :disabled="total < 16 || !isMealOpen(meal)" @click="checkout">去结算</button>
			</view>
		</view>
		<view v-if="priceDish !== null" class="sheet-mask"><view class="sheet"><text class="g-cap">素菜加价</text><text class="sheet-title">{{priceDish?.name}}</text><text class="g-sub">请输入你愿意支付的价格（不低于 {{priceDish?.price}} 元）</text><input class="g-field-input price-input" type="number" v-model="customPrice"/><button class="g-btn-primary cta" @click="confirmCustomPrice">加入菜单</button><button class="g-btn-ghost cta" @click="priceDish = null">取消</button></view></view>
		<view v-if="toastMessage !== ''" class="g-toast"><text class="toast-text">{{toastMessage}}</text></view>
	</view>
</template>

<script setup lang="uts">
	import { requestJson } from '../../common/http.uts'

	type Dish = { id: string; category: string; name: string; desc: string; price: number; pay: number; qty: number; custom: boolean; sold: boolean; image: string }
	type OrderLine = { id: string; qty: number; pay: number }
	type OrderSnapshot = { name: string; qty: number; pay: number }
	// 【测试开关】true = 暂时解除两餐截单限制，随时可走完整下单 + 模拟支付流程。
	// 与 cf-api 里的 BYPASS_CUTOFF 配套；正式上线前两处都要关掉！
	const testBypass = true
	const screen = ref('home')
	const loading = ref(false)
	const submitting = ref(false)
	const countdown = ref('--:--')
	const dateLabel = ref('')
	const toastMessage = ref('')
	const customer = reactive({name: '', location: '', phone: '', note: ''})
	const orderNumber = ref('')
	const customPrice = ref('3')
	// 幂等键：每次进入支付页生成一个，网络重试/重复点击时服务端据此去重
	const payRequestId = ref('')
	const priceDish = ref<Dish | null>(null)
	const categories = ['素菜', '荤素搭配', '纯荤']
	const dishes = ref<Dish[]>([])
	const activePill = ref('素菜')
	const menuAnchor = ref('')
	const orderItems = ref<OrderSnapshot[]>([])
	const orderTotal = ref(0)
	const total = computed(() => dishes.value.reduce((sum, dish) => sum + dish.qty * dish.pay, 0))
	const itemCount = computed(() => dishes.value.reduce((sum, dish) => sum + dish.qty, 0))
	const selectedDishes = computed(() => dishes.value.filter((dish) => dish.qty > 0))
	// 取餐码：订单号尾段自带餐次（FJ-MMDD-L001 → #L001）
	const pickupCode = computed(() => { const no = orderNumber.value; if (no.length >= 4) { return '#' + no.substring(no.length - 4) } return '--' })

	// ---------- 餐次配置：与 cf-api/lib/config.js 的 MEALS 保持一致，改两处要同步 ----------
	class MealCfg {
		key: string = ''
		label: string = ''
		prepMin: number = 0
		orderCloseMin: number = 0
		readyMin: number = 0
		closeMin: number = 0
		prepLabel: string = ''
		orderCloseLabel: string = ''
		readyLabel: string = ''
		closeLabel: string = ''
		suggest: string = ''
	}
	const MEAL_LUNCH = new MealCfg()
	MEAL_LUNCH.key = 'lunch'; MEAL_LUNCH.label = '午餐'; MEAL_LUNCH.prepMin = 600; MEAL_LUNCH.orderCloseMin = 660; MEAL_LUNCH.readyMin = 690; MEAL_LUNCH.closeMin = 780
	MEAL_LUNCH.prepLabel = '10:00'; MEAL_LUNCH.orderCloseLabel = '11:00'; MEAL_LUNCH.readyLabel = '11:30'; MEAL_LUNCH.closeLabel = '13:00'; MEAL_LUNCH.suggest = '12:40 前后'
	const MEAL_DINNER = new MealCfg()
	MEAL_DINNER.key = 'dinner'; MEAL_DINNER.label = '晚餐'; MEAL_DINNER.prepMin = 900; MEAL_DINNER.orderCloseMin = 960; MEAL_DINNER.readyMin = 1050; MEAL_DINNER.closeMin = 1170
	MEAL_DINNER.prepLabel = '15:00'; MEAL_DINNER.orderCloseLabel = '16:00'; MEAL_DINNER.readyLabel = '17:30'; MEAL_DINNER.closeLabel = '19:30'; MEAL_DINNER.suggest = '18:30 前后'
	function cfgOf(key: string): MealCfg { return key === 'dinner' ? MEAL_DINNER : MEAL_LUNCH }

	// 当前点单餐次（入口决定，整条流程锁定）
	const meal = ref('lunch')
	// 餐次状态：open 可点单 / cooking 制作中 / ready 可取餐 / closed 已收档
	const mealState = reactive({ lunch: 'open', dinner: 'open' })
	// 首页时刻轴当前展示的餐次
	const homeMeal = ref('lunch')
	function stateOf(key: string): string { return key === 'dinner' ? mealState.dinner : mealState.lunch }
	function setMealState(key: string, s: string) { if (key === 'dinner') { mealState.dinner = s } else { mealState.lunch = s } }
	function isMealOpen(key: string): boolean { if (testBypass) return true; return stateOf(key) === 'open' }

	// 首页主打：第一道在售荤菜（荤素搭配 → 纯荤 → 素菜）
	const todayDish = computed((): Dish | null => {
		const pool = dishes.value.filter((dish) => !dish.sold)
		let pick = pool.find((dish) => dish.category === '荤素搭配')
		if (pick === null) { pick = pool.find((dish) => dish.category === '纯荤') }
		if (pick === null) { pick = pool.find((dish) => dish.category === '素菜') }
		return pick
	})
	const homeHeadline = computed((): string => { const dish = todayDish.value; if (dish === null) return '今日菜单已出'; return '今天吃' + dish.name })
	const locLabel = computed((): string => { const loc = customer.location.trim(); if (loc === '') return '大堂自取'; return loc })
	const mealLabel = computed((): string => { return cfgOf(meal.value).label })
	const mealCloseLabel = computed((): string => { return cfgOf(meal.value).orderCloseLabel })
	const menuSub = computed((): string => { const c = cfgOf(meal.value); return dateLabel.value + ' · ' + c.orderCloseLabel + ' 截单 · ' + c.readyLabel + ' 出炉' })
	const checkSub = computed((): string => { const c = cfgOf(meal.value); return '截单后开火现炒 · ' + c.closeLabel + ' 前请到大堂取餐' })
	const suggestPickup = computed((): string => { return cfgOf(meal.value).suggest })
	// 时刻轴四个停靠点文案（随 homeMeal 切换）
	const tlL0 = computed((): string => { return cfgOf(homeMeal.value).prepLabel + ' 备菜' })
	const tlL1 = computed((): string => { return cfgOf(homeMeal.value).orderCloseLabel + ' 开火' })
	const tlL2 = computed((): string => { return cfgOf(homeMeal.value).readyLabel + ' 出炉' })
	const tlL3 = computed((): string => { return cfgOf(homeMeal.value).closeLabel + ' 收档' })

	// 开火时刻轴：prep 备菜 → orderClose 开火(截单) → ready 出炉 → close 收档
	const tlPos = ref(0)
	const tlStatus = ref('')
	const tlRight = ref('')
	function dishesByCategory(category: string): Dish[] { return dishes.value.filter((dish) => dish.category === category) }
	function minPrice(category: string): number { let min = 0; dishes.value.forEach((dish: Dish) => { if (dish.category === category && (min === 0 || dish.price < min)) { min = dish.price } }); return min }
	function jumpCategory(category: string, index: number) { activePill.value = category; menuAnchor.value = 'cat-' + index }
	function toast(msg: string) { toastMessage.value = msg; setTimeout(() => { toastMessage.value = '' }, 1800) }
	function pad2(n: number): string { return n < 10 ? '0' + n : '' + n }
	function bjNow(): Date { const now = new Date(); return new Date(now.getTime() + (480 + now.getTimezoneOffset()) * 60000) }
	function updateMealState(key: string, min: number) {
		const c = cfgOf(key)
		let s = 'closed'
		if (min < c.closeMin) { if (min < c.orderCloseMin) { s = 'open' } else if (min < c.readyMin) { s = 'cooking' } else { s = 'ready' } }
		setMealState(key, s)
	}
	function entryStateText(key: string): string { const s = stateOf(key); if (s === 'open') return '可点单'; if (s === 'cooking') return '制作中'; if (s === 'ready') return '可取餐'; return '已收档' }
	function entryStateClass(key: string): string { const s = stateOf(key); if (s === 'open') return 'st-open'; if (s === 'cooking') return 'st-cooking'; if (s === 'ready') return 'st-ready'; return 'st-closed' }
	function tick() {
		const now = bjNow()
		const min = now.getUTCHours() * 60 + now.getUTCMinutes()
		updateMealState('lunch', min)
		updateMealState('dinner', min)
		// 展示中的餐次收档了就自动切到另一餐（两餐都收档则保持）
		if (stateOf(homeMeal.value) === 'closed') {
			const other = homeMeal.value === 'lunch' ? 'dinner' : 'lunch'
			if (stateOf(other) !== 'closed') { homeMeal.value = other }
		}
		// 时刻轴：分钟数分段线性映射到 0~100%
		const c = cfgOf(homeMeal.value)
		let pos = 0
		if (min <= c.prepMin) { pos = 0 } else if (min >= c.closeMin) { pos = 100 } else if (min <= c.orderCloseMin) { pos = (min - c.prepMin) / (c.orderCloseMin - c.prepMin) * 33.3 } else if (min <= c.readyMin) { pos = 33.3 + (min - c.orderCloseMin) / (c.readyMin - c.orderCloseMin) * 33.3 } else { pos = 66.6 + (min - c.readyMin) / (c.closeMin - c.readyMin) * 33.4 }
		tlPos.value = Math.round(pos * 10) / 10
		const state = stateOf(homeMeal.value)
		// 倒计时数字（供 open 状态显示，先算再用）
		const dayStart = Math.floor(now.getTime() / 86400000) * 86400000
		const diffOpen = dayStart + c.orderCloseMin * 60000 - now.getTime()
		if (diffOpen <= 0) { countdown.value = '已截单' } else { const s = Math.floor(diffOpen / 1000); const h = Math.floor(s / 3600); const m = Math.floor((s % 3600) / 60); countdown.value = h + ':' + pad2(m) + ':' + pad2(s % 60) }
		if (state === 'closed') {
			tlStatus.value = '今日已收档 · 明天再来'
			tlRight.value = ''
		} else {
			const hm = now.getUTCHours() + ':' + pad2(now.getUTCMinutes())
			if (state === 'open') { tlStatus.value = hm + ' · 接受点单中' } else if (state === 'cooking') { tlStatus.value = hm + ' · 后厨开火中' } else { tlStatus.value = hm + ' · 已出炉 · 可取餐' }
			// 右侧：距本餐截单倒计时 / 出炉与取餐提示
			if (state === 'open') { tlRight.value = '距截单 ' + countdown.value } else if (state === 'cooking') { tlRight.value = c.readyLabel + ' 出炉' } else { tlRight.value = c.closeLabel + ' 前取餐' }
		}
	}
	// 菜单指纹：id+菜名+价格+售罄，用于判断厨房端是否发布过新菜单
	function menuSignature(list: Dish[]): string {
		let s = ''
		list.forEach((d: Dish) => { s += d.id + ':' + d.name + ':' + d.price + ':' + (d.sold ? '1' : '0') + '|' })
		return s
	}
	// silent=true：页面重新显示时的静默刷新（不转圈、失败不弹错），并保留已选数量
	async function loadMenu(silent: boolean) {
		if (!silent) loading.value = true
		try {
			const result = await requestJson('/cf-menu', { action: 'getToday' } as UTSJSONObject)
			if (result !== null && result.getBoolean('ok') === true) {
				const data = result.getJSON('data')
				if (data instanceof UTSJSONObject) {
					dateLabel.value = data.getString('dateLabel') ?? ''
					const arr = data.getArray('dishes')
					const list: Dish[] = []
					if (arr !== null) {
						for (let i = 0; i < arr.length; i++) {
							const o = arr[i]
							if (o instanceof UTSJSONObject) {
								const base = o.getNumber('basePrice') ?? 0
								list.push({ id: o.getString('id') ?? '', category: o.getString('category') ?? '', name: o.getString('name') ?? '', desc: o.getString('desc') ?? '', price: base, pay: base, qty: 0, custom: o.getBoolean('canCustomPrice') === true, sold: o.getBoolean('soldOut') === true, image: o.getString('image') ?? '' })
							}
						}
					}
					// 同 id 且价格没变的菜保留已选数量/加价；新菜、改价、删除的按默认处理
					const oldList = dishes.value
					for (let i = 0; i < list.length; i++) {
						const nd = list[i]
						const od = oldList.find((item) => item.id === nd.id && item.price === nd.price)
						if (od !== null) { nd.qty = od.qty; nd.pay = od.pay }
					}
					const changed = silent && menuSignature(oldList) !== menuSignature(list)
					dishes.value = list
					if (changed) { toast('菜单已更新') }
				}
			} else if (!silent) { toast('今日菜单加载失败，请稍后再试') }
		} catch (e) { if (!silent) toast('网络异常，请检查网络后重试') }
		if (!silent) loading.value = false
	}
	function goAdmin() { uni.navigateTo({ url: '/pages/admin/admin' }) }
	// 取餐点胶囊：跳到「我的」维护常用取餐位置
	function goProfile() { uni.switchTab({ url: '/pages/profile/profile' }) }
	// 餐次入口：锁定本单餐次进入菜单
	function enterMeal(key: string) {
		if (!isMealOpen(key)) { toast(cfgOf(key).label + '已截单，明天再来'); return }
		meal.value = key
		activePill.value = '素菜'
		menuAnchor.value = ''
		screen.value = 'menu'
	}
	function changeQty(id: string, amount: number) {
		const dish = dishes.value.find((item) => item.id === id)
		if (dish === null || dish === undefined) return
		if (amount > 0 && dish.custom && dish.qty === 0) { priceDish.value = dish; customPrice.value = dish.price.toString(); return }
		dish.qty = Math.max(0, dish.qty + amount)
		if (dish.qty === 0) dish.pay = dish.price
	}
	function confirmCustomPrice() { const dish = priceDish.value; const value = Number(customPrice.value); if (dish !== null && value >= dish.price) { dish.pay = value; dish.qty += 1; priceDish.value = null } else { toast('价格不能低于起价') } }
	function checkout() { if (total.value < 16) return; if (!isMealOpen(meal.value)) { toast(mealLabel.value + '已截单，请改点另一餐'); return } screen.value = 'check' }
	// 结算页 → 模拟支付页：先做基础校验，订单在点「确认支付」后才真正创建。
	// 每次进入支付页生成新的幂等键：同一次支付意图重试不重复建单，重新下单则是新键
	function goPay() {
		if (submitting.value) return
		if (customer.name.trim() === '' || customer.location.trim() === '') { toast('请填写姓名和取餐位置'); return }
		if (!isMealOpen(meal.value)) { toast(mealLabel.value + '已截单，明天再来'); return }
		if (selectedDishes.value.length === 0) { toast('先去菜单挑几个菜'); return }
		payRequestId.value = 'r' + Date.now().toString(36) + Math.floor(Math.random() * 1e9).toString(36)
		screen.value = 'pay'
	}
	async function confirmOrder() {
		if (submitting.value) return
		if (customer.name.trim() === '' || customer.location.trim() === '') { toast('请填写姓名和取餐位置'); return }
		if (!isMealOpen(meal.value)) { toast(mealLabel.value + '已截单，明天再来'); return }
		const items: OrderLine[] = []
		selectedDishes.value.forEach((dish: Dish) => { const line: OrderLine = { id: dish.id, qty: dish.qty, pay: dish.pay }; items.push(line) })
		if (items.length === 0) { toast('先去菜单挑几个菜'); return }
		submitting.value = true
		try {
			const result = await requestJson('/cf-order', { action: 'create', meal: meal.value, request_id: payRequestId.value, items: items, customer: { name: customer.name, location: customer.location, phone: customer.phone, note: customer.note } } as UTSJSONObject)
			if (result !== null && result.getBoolean('ok') === true) {
				const data = result.getJSON('data')
				if (data instanceof UTSJSONObject) { orderNumber.value = data.getString('orderNo') ?? '' }
				// 快照本单明细与小票数据（下单成功后清空购物车，页面仍能展示）
				const snapshot: OrderSnapshot[] = []
				selectedDishes.value.forEach((dish: Dish) => { snapshot.push({ name: dish.name, qty: dish.qty, pay: dish.pay }) })
				orderItems.value = snapshot
				orderTotal.value = total.value
				dishes.value.forEach((dish: Dish) => { dish.qty = 0; dish.pay = dish.price })
				screen.value = 'success'
			} else { toast(result !== null ? (result.getString('err') ?? '下单失败，请重试') : '下单失败，请重试') }
		} catch (e) { toast('网络异常，请稍后再试') }
		submitting.value = false
	}
	// ---------- 微信静默登录（全程不弹 toast，失败只记日志，游客照常下单） ----------
	// uni.login 回调转 Promise：拿微信登录 code（拿不到返回空串）
	function getWxCode(): Promise<string> {
		return new Promise<string>((resolve) => {
			uni.login({
				provider: 'weixin',
				success: (res) => { resolve(res.code ?? '') },
				fail: (err) => { console.log('uni.login fail', err); resolve('') }
			})
		})
	}
	// 从 data 里取资料（login / getProfile 两种响应都带 data.profile）
	function pickProfile(data: UTSJSONObject): UTSJSONObject | null {
		const p = data.getJSON('profile')
		if (p instanceof UTSJSONObject) return p
		return null
	}
	// 静默登录全流程：有 token 先验（getProfile）→ 失效清掉重登一次；无 token 直接微信登录。
	// 成功返回资料（可能为 null），失败返回 null
	async function ensureLogin(): Promise<UTSJSONObject | null> {
		try {
			const t = uni.getStorageSync('xk_user_token')
			if (t !== '' && t !== null) {
				const r = await requestJson('/cf-user', { action: 'getProfile' } as UTSJSONObject)
				if (r !== null && r.getBoolean('ok') === true) {
					const d = r.getJSON('data')
					if (d instanceof UTSJSONObject) { return pickProfile(d) }
					return null
				}
				if (r !== null && (r.getString('err') ?? '').indexOf('登录') !== -1) {
					// token 失效：清掉后走一次重新登录
					uni.removeStorageSync('xk_user_token')
				} else { return null }
			}
			const code = await getWxCode()
			if (code === '') { console.log('ensureLogin: 未拿到微信 code'); return null }
			const r2 = await requestJson('/cf-user', { action: 'login', code: code } as UTSJSONObject)
			if (r2 !== null && r2.getBoolean('ok') === true) {
				const d2 = r2.getJSON('data')
				if (d2 instanceof UTSJSONObject) {
					const token = d2.getString('token') ?? ''
					if (token !== '') { uni.setStorageSync('xk_user_token', token) }
					return pickProfile(d2)
				}
			}
			console.log('ensureLogin: 登录失败', r2 !== null ? (r2.getString('err') ?? '') : '网络异常')
			return null
		} catch (e) { console.log('ensureLogin fail', e); return null }
	}
	// 登录成功后回填常用信息：逐项非空才覆盖，不清空用户已输入内容
	async function silentLogin() {
		const profile = await ensureLogin()
		if (profile === null) return
		const name = profile.getString('name') ?? ''
		const location = profile.getString('location') ?? ''
		const phone = profile.getString('phone') ?? ''
		if (name !== '') customer.name = name
		if (location !== '') customer.location = location
		if (phone !== '') customer.phone = phone
	}
	// 首次进入：正常加载（带 loading 转圈）
	let firstShow = true
	// 每次页面显示（含从厨房端返回、小程序切回前台）都静默刷新菜单：
	// 厨房端发布菜单后，用户一回到点单页立即生效
	onShow(() => {
		loadMenu(!firstShow)
		firstShow = false
	})
	// 首次进入时静默登录并回填常用信息（失败不打扰点单，仅记日志）
	onLoad(() => { silentLogin() })
	tick()
	const tickTimer = setInterval(tick, 1000)
	// 页面销毁时清理计时器，避免页面重建后叠加多个定时器
	onUnload(() => { clearInterval(tickTimer) })
</script>

<style>
	.page { flex: 1; background-color: #FFFFFF; color: #141418; }
	.scroll { flex: 1; }
	.home-content, .menu-content, .check-content, .pay-content, .success-content { padding: 20px 20px 36px; }
	/* ---------- 首页 ---------- */
	.brand-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 8px; }
	.brand-left { display: flex; flex-direction: column; }
	.wordmark { font-size: 32px; font-weight: 900; line-height: 40px; color: #141418; }
	.brand-sub { margin-top: 3px; }
	.loc-pill { display: flex; flex-direction: row; align-items: center; border: 1px solid #ECECEB; border-radius: 999px; padding: 7px 12px; background-color: #FFFFFF; }
	.loc-dot { width: 6px; height: 6px; border-radius: 3px; background-color: #FF4A17; margin-right: 6px; }
	.loc-text { font-size: 12px; font-weight: 600; color: #141418; }
	/* 开火时刻轴 */
	.timeline { margin-top: 18px; }
	.tl-meals { display: flex; flex-direction: row; margin-bottom: 12px; }
	.tl-meal-chip { border: 1px solid #ECECEB; border-radius: 999px; padding: 5px 14px; margin-right: 8px; background-color: #FFFFFF; }
	.tl-meal-chip.on { border-color: #141418; background-color: #141418; }
	.tl-meal-text { font-size: 12px; font-weight: 600; color: #141418; }
	.tl-meal-text.on { color: #FFFFFF; font-weight: 700; }
	.tl-now { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
	.tl-status { display: flex; flex-direction: row; align-items: center; }
	.tl-livedot { width: 8px; height: 8px; border-radius: 4px; background-color: #FF4A17; margin-right: 7px; }
	.tl-status-text { font-size: 12px; font-weight: 700; color: #141418; }
	.tl-right { font-size: 11px; color: #86868B; }
	.tl-track { position: relative; height: 2px; background-color: #ECECEB; border-radius: 1px; }
	.tl-done { position: absolute; left: 0; top: 0; height: 2px; background-color: #141418; border-radius: 1px; }
	.tl-stop { position: absolute; top: -2px; width: 6px; height: 6px; border-radius: 3px; background-color: #D9D9D7; margin-left: -3px; }
	.tl-stop.past { background-color: #141418; }
	.tl-nowdot { position: absolute; top: -5px; width: 12px; height: 12px; border-radius: 6px; background-color: #FF4A17; border: 2px solid #FFFFFF; margin-left: -6px; }
	.tl-labels { position: relative; height: 16px; margin-top: 8px; }
	.tl-label { position: absolute; font-size: 10px; color: #86868B; }
	.tl-label.s0 { left: 0; color: #141418; font-weight: 600; }
	.tl-label.s1 { left: 33.3%; margin-left: -24px; }
	.tl-label.s2 { left: 66.6%; margin-left: -24px; }
	.tl-label.s3 { right: 0; }
	/* 主打大图 */
	.hero { margin-top: 18px; }
	.hero-pic { position: relative; border-radius: 20px; overflow: hidden; height: 190px; background-color: #F6F6F4; }
	.hero-img { width: 100%; height: 190px; }
	.hero-chip { position: absolute; left: 12px; bottom: 12px; }
	.hero-chip-text { color: #FFFFFF; font-size: 11px; font-weight: 600; }
	.home-h2 { display: block; font-size: 24px; font-weight: 900; margin-top: 14px; color: #141418; }
	.home-sub { display: block; font-size: 12px; color: #86868B; margin-top: 6px; line-height: 1.6; }
	/* 双餐次入口 */
	.entries { margin-top: 18px; }
	.entry { display: flex; flex-direction: row; align-items: center; justify-content: space-between; border: 1px solid #ECECEB; border-radius: 18px; padding: 15px 16px; margin-bottom: 10px; background-color: #FFFFFF; }
	.entry-main { flex: 1; min-width: 0; }
	.entry-title-row { display: flex; flex-direction: row; align-items: center; }
	.entry-title { font-size: 17px; font-weight: 800; color: #141418; margin-right: 8px; }
	.entry-state { font-size: 10px; font-weight: 700; border-radius: 6px; padding: 3px 8px; }
	.st-open { background-color: #141418; color: #FFFFFF; }
	.st-cooking { background-color: #FFFFFF; color: #141418; border: 1px solid #ECECEB; }
	.st-ready { background-color: #FF4A17; color: #FFFFFF; }
	.st-closed { background-color: #F6F6F4; color: #86868B; }
	.entry-meta { display: block; font-size: 11px; color: #86868B; margin-top: 5px; }
	.entry-arrow { font-size: 20px; color: #B9B9BE; margin-left: 10px; }
	.facts { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 16px; }
	.fact-chip { margin: 0 7px 7px 0; }
	.fact-text { font-size: 11px; font-weight: 600; color: #141418; }
	.admin-entry { display: flex; flex-direction: row; justify-content: center; margin-top: 16px; }
	/* ---------- 通用 ---------- */
	.cta { width: 100%; margin-top: 18px; }
	.back { width: 36px; height: 36px; border-radius: 18px; background-color: #FFFFFF; border: 1px solid #ECECEB; font-size: 20px; line-height: 34px; color: #86868B; margin: 0; padding: 0; }
	/* ---------- 菜单 ---------- */
	.menu-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; margin-top: 8px; }
	.menu-date { display: block; font-size: 11px; color: #86868B; margin-top: 5px; }
	.pills { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
	.pill { border: 1px solid #ECECEB; background-color: #FFFFFF; border-radius: 999px; padding: 6px 14px; margin: 0 7px 7px 0; }
	.pill-active { border-color: #141418; background-color: #141418; }
	.pill-text { font-size: 12px; color: #141418; }
	.pill-text-active { color: #FFFFFF; font-weight: 700; }
	.menu-state { display: block; text-align: center; padding: 24px 0; }
	.cat-head { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; margin: 18px 0 4px; }
	.cat-title { font-size: 15px; font-weight: 800; color: #141418; }
	.cat-price { font-size: 11px; color: #86868B; }
	.dish { display: flex; flex-direction: row; align-items: center; padding: 13px 0; border-bottom: 1px solid #ECECEB; }
	.category .dish:last-child { border-bottom: 0; }
	.dish-ph { position: relative; width: 80px; height: 80px; border-radius: 16px; overflow: hidden; background-color: #F6F6F4; flex-shrink: 0; }
	.dish-image { width: 80px; height: 80px; }
	.dish.sold .dish-image { opacity: 0.45; }
	.dish-sold-chip { position: absolute; left: 0; right: 0; top: 30px; display: flex; flex-direction: row; justify-content: center; }
	.dish-sold-text { background-color: #F6F6F4; color: #86868B; font-size: 10px; font-weight: 600; border-radius: 6px; padding: 4px 8px; }
	.dish-main { flex: 1; min-width: 0; margin-left: 13px; }
	.dish-name-row { display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; }
	.dish-name { font-size: 16px; font-weight: 700; color: #141418; }
	.dish.sold .dish-name { color: #86868B; }
	.badge-add { color: #FF4A17; background-color: #FFFFFF; border: 1px solid #FF4A17; border-radius: 6px; padding: 1px 6px; font-size: 10px; font-weight: 600; margin-left: 6px; }
	.dish-desc { display: block; color: #86868B; font-size: 12px; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.dish-price { display: block; font-size: 18px; margin-top: 8px; }
	.dish.sold .dish-price { color: #86868B; }
	.add-btn { width: 30px; height: 30px; border-radius: 15px; background-color: #141418; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
	.add-plus { color: #FFFFFF; font-size: 17px; line-height: 17px; margin-top: -2px; }
	.add-dim { background-color: #F6F6F4; }
	.add-dim .add-plus { color: #B9B9BE; }
	.stepper { display: flex; flex-direction: row; align-items: center; flex-shrink: 0; }
	.step-btn { width: 28px; height: 28px; border-radius: 14px; display: flex; align-items: center; justify-content: center; }
	.step-minus { background-color: #F6F6F4; }
	.step-char { color: #86868B; font-size: 15px; line-height: 15px; margin-top: -2px; }
	.step-plus { background-color: #141418; margin-left: 4px; }
	.step-char-plus { color: #FFFFFF; }
	.step-num { min-width: 24px; text-align: center; font-size: 14px; font-weight: 700; color: #141418; }
	/* ---------- 结算 ---------- */
	.order-card { margin-top: 16px; }
	.card-title { display: block; margin-bottom: 10px; }
	.order-line { display: flex; flex-direction: row; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid #ECECEB; }
	.order-line-name { font-size: 13px; color: #141418; }
	.order-line-price { font-size: 13px; font-weight: 700; color: #141418; }
	.order-total { display: flex; flex-direction: row; justify-content: space-between; padding-top: 12px; }
	.order-total-label { font-size: 14px; font-weight: 700; color: #141418; }
	.total-number { font-size: 18px; }
	.form-field { margin-top: 14px; }
	.form-label-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 6px; }
	.notice { background-color: #F6F6F4; border-radius: 12px; padding: 10px 12px; margin-top: 16px; }
	.notice-text { color: #86868B; font-size: 11.5px; line-height: 1.7; }
	/* ---------- 模拟支付 ---------- */
	.pay-content { display: flex; flex-direction: column; align-items: center; }
	.pay-card { width: 100%; background-color: #FFFFFF; border: 1px solid #ECECEB; border-radius: 20px; padding: 26px 16px 22px; display: flex; flex-direction: column; align-items: center; margin-top: 10px; }
	.pay-merchant { display: flex; flex-direction: row; align-items: center; }
	.pay-avatar { width: 40px; height: 40px; border-radius: 12px; background-color: #141418; display: flex; align-items: center; justify-content: center; }
	.pay-avatar-char { color: #FFFFFF; font-size: 20px; font-weight: 900; }
	.pay-merchant-name { font-size: 15px; font-weight: 700; color: #141418; margin-left: 9px; }
	.pay-amount { font-size: 44px; font-weight: 800; color: #141418; margin-top: 18px; }
	.pay-mode { color: #86868B; font-size: 12px; margin-top: 8px; }
	.pay-content .notice { width: 100%; box-sizing: border-box; }
	/* ---------- 成功 ---------- */
	.ok-wrap { display: flex; flex-direction: column; align-items: center; padding-top: 16px; }
	.success-mark { width: 64px; height: 64px; border-radius: 32px; background-color: #141418; display: flex; align-items: center; justify-content: center; }
	.success-mark-char { color: #FFFFFF; font-size: 28px; }
	.success-title { display: block; font-size: 24px; font-weight: 900; margin-top: 14px; color: #141418; }
	.success-note { display: block; margin-top: 6px; text-align: center; }
	.ticket { width: 100%; border: 1px solid #ECECEB; border-radius: 20px; margin-top: 18px; padding: 16px; box-sizing: border-box; }
	.pcode-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding-bottom: 14px; }
	.pcode-left { display: flex; flex-direction: column; }
	.pcode { font-size: 34px; font-weight: 900; color: #141418; margin-top: 6px; letter-spacing: 0.06em; }
	.ticket-no { font-size: 11px; color: #86868B; }
	.ticket-body { padding-top: 12px; }
