<template>
	<view class="page">
		<!-- 登录态卡：第一版不做微信头像昵称，仅展示自动登录状态 -->
		<view class="card login-card">
			<view class="avatar"><text class="avatar-char">微</text></view>
			<view class="login-main">
				<text v-if="loginOk" class="login-title">微信用户 · 已自动登录</text>
				<text v-else-if="loginChecking" class="login-title">正在登录…</text>
				<text v-else class="login-title">未登录</text>
				<text v-if="!loginOk && !loginChecking && loginErr !== ''" class="login-err">{{loginErr}}</text>
			</view>
			<button v-if="!loginOk && !loginChecking" class="relogin" @click="manualLogin">重新登录</button>
		</view>

		<!-- 常用信息卡：保存后点单页自动回填 -->
		<view class="card">
			<text class="card-title">常 用 信 息</text>
			<view class="form-field"><view class="form-label-row"><text class="form-label">姓名</text><text class="req">*</text></view><input v-model="form.name" placeholder="如：张三 / 3 楼财务" placeholder-class="ph" /></view>
			<view class="form-field"><view class="form-label-row"><text class="form-label">手机号（选填）</text></view><input v-model="form.phone" type="number" placeholder="异常联系用" placeholder-class="ph" /></view>
			<view class="form-field"><view class="form-label-row"><text class="form-label">常用取餐位置（选填）</text></view><input v-model="form.location" placeholder="例如：产品部 · 18F" placeholder-class="ph" /></view>
			<button class="primary" :disabled="saving" @click="saveProfile">{{saving ? '保存中…' : '保存'}}</button>
		</view>

		<!-- 我的订单卡 -->
		<view class="card">
			<text class="card-title">我 的 订 单</text>
			<text v-if="ordersLoading && loginOk" class="muted">正在加载订单…</text>
			<text v-else-if="orders.length === 0" class="muted order-empty">{{loginOk ? '还没有订单' : '登录后即可查看订单'}}</text>
			<view v-else>
				<view v-for="order in orders" :key="order.orderNo" class="order-item">
					<view class="order-head">
						<text class="mono order-no">{{order.orderNo}}</text>
						<text class="oc-status" :class="statusClass(order.status)">{{statusText(order.status)}}</text>
					</view>
					<view v-for="(item, idx) in order.items" :key="idx" class="order-line">
						<text class="order-line-name">{{item.name}} × {{item.qty}}</text>
						<text class="mono order-line-price">¥{{item.pay * item.qty}}</text>
					</view>
					<view class="order-foot">
						<text class="mono order-time">{{fmtTime(order.createdAt)}}</text>
						<view class="order-total-row"><text class="order-total-label">合计</text><text class="mono order-total-num">¥{{order.total}}</text></view>
					</view>
				</view>
			</view>
		</view>

		<text class="foot-note">在线支付即将上线</text>
		<view v-if="toastMessage !== ''" class="toast">{{toastMessage}}</view>
	</view>
</template>

<script setup lang="uts">
	import { requestJson } from '../../common/http.uts'

	type OrderItem = { name: string; pay: number; qty: number }
	type MyOrder = { orderNo: string; status: string; total: number; items: OrderItem[]; createdAt: number }

	// 登录态：loginOk 已登录 / loginChecking 登录中 / 失败时 loginErr 给出原因
	const loginOk = ref(false)
	const loginChecking = ref(true)
	const loginErr = ref('')
	const form = reactive({name: '', phone: '', location: ''})
	const saving = ref(false)
	const orders = ref<MyOrder[]>([])
	const ordersLoading = ref(true)
	const toastMessage = ref('')

	function toast(msg: string) { toastMessage.value = msg; setTimeout(() => { toastMessage.value = '' }, 1800) }
	function pad2(n: number): string { return n < 10 ? '0' + n : '' + n }
	// 北京时间格式化下单时间（与 index 页 bjNow 同一换算口径）
	function fmtTime(ms: number): string {
		const d = new Date(ms + (480 + new Date(ms).getTimezoneOffset()) * 60000)
		return pad2(d.getUTCMonth() + 1) + '-' + pad2(d.getUTCDate()) + ' ' + pad2(d.getUTCHours()) + ':' + pad2(d.getUTCMinutes())
	}
	function statusText(s: string): string { if (s === 'cooking') return '制作中'; if (s === 'ready') return '可取餐'; if (s === 'canceled') return '已取消'; return '待处理' }
	function statusClass(s: string): string { if (s === 'cooking') return 'st-cooking'; if (s === 'ready') return 'st-ready'; if (s === 'canceled') return 'st-cancel'; return 'st-pending' }

	// uni.login 回调转 Promise：拿微信登录 code（拿不到返回空串）
	function getWxCode(): Promise<string> {
		return new Promise<string>((resolve) => {
			uni.login({
				provider: 'weixin',
				success: (res) => { resolve(res.code ?? '') },
				fail: (err) => { console.log('uni.login fail', err); resolve('') }
			})
		})
	}
	// 从 data 里取资料（login / getProfile 两种响应都带 data.profile）
	function pickProfile(data: UTSJSONObject): UTSJSONObject | null {
		const p = data.getJSON('profile')
		if (p instanceof UTSJSONObject) return p
		return null
	}
	// 静默登录全流程：有 token 先验（getProfile）→ 失效清掉重登一次；无 token 直接微信登录。
	// 整个流程静默不弹窗，失败只把登录态卡标成未登录。成功返回资料（可能为 null）
	async function ensureLogin(): Promise<UTSJSONObject | null> {
		if (!loginOk.value) { loginChecking.value = true }
		loginErr.value = ''
		try {
			const t = uni.getStorageSync('xk_user_token')
			if (t !== '' && t !== null) {
				const r = await requestJson('/cf-user', { action: 'getProfile' } as UTSJSONObject)
				if (r !== null && r.getBoolean('ok') === true) {
					const d = r.getJSON('data')
					if (d instanceof UTSJSONObject) {
						loginOk.value = true
						loginChecking.value = false
						return pickProfile(d)
					}
					loginChecking.value = false
					return null
				}
				if (r !== null && (r.getString('err') ?? '').indexOf('登录') !== -1) {
					// token 失效：清掉后走一次重新登录
					uni.removeStorageSync('xk_user_token')
				} else {
					loginChecking.value = false
					loginErr.value = r !== null ? (r.getString('err') ?? '登录失败') : '网络异常，请检查网络'
					return null
				}
			}
			// 无 token / token 刚失效：微信静默登录换新 token
			const code = await getWxCode()
			if (code === '') { loginChecking.value = false; loginErr.value = '微信登录失败，请重试'; return null }
			const r2 = await requestJson('/cf-user', { action: 'login', code: code } as UTSJSONObject)
			if (r2 !== null && r2.getBoolean('ok') === true) {
				const d2 = r2.getJSON('data')
				if (d2 instanceof UTSJSONObject) {
					const token = d2.getString('token') ?? ''
					if (token !== '') { uni.setStorageSync('xk_user_token', token) }
					loginOk.value = true
					loginChecking.value = false
					return pickProfile(d2)
				}
			}
			loginChecking.value = false
			loginErr.value = r2 !== null ? (r2.getString('err') ?? '登录失败，请重试') : '网络异常，请检查网络'
			console.log('ensureLogin fail', loginErr.value)
			return null
		} catch (e) {
			console.log('ensureLogin fail', e)
			loginChecking.value = false
			loginErr.value = '登录失败，请重试'
			return null
		}
	}
	// 把服务端资料回填到输入框（进入页面/下拉刷新时以服务端为准）
	function applyProfile(p: UTSJSONObject | null) {
		if (p === null) return
		form.name = p.getString('name') ?? ''
		form.phone = p.getString('phone') ?? ''
		form.location = p.getString('location') ?? ''
	}
	// 解析 myOrders 响应里的订单数组
	function parseOrders(r: UTSJSONObject): MyOrder[] {
		const list: MyOrder[] = []
		const data = r.getJSON('data')
		if (data instanceof UTSJSONObject) {
			const arr = data.getArray('orders')
			if (arr !== null) {
				for (let i = 0; i < arr.length; i++) {
					const o = arr[i]
					if (o instanceof UTSJSONObject) {
						const items: OrderItem[] = []
						const iarr = o.getArray('items')
						if (iarr !== null) {
							for (let j = 0; j < iarr.length; j++) {
								const it = iarr[j]
								if (it instanceof UTSJSONObject) {
									items.push({ name: it.getString('name') ?? '', pay: it.getNumber('pay') ?? 0, qty: Math.floor(it.getNumber('qty') ?? 0) })
								}
							}
						}
						list.push({ orderNo: o.getString('orderNo') ?? '', status: o.getString('status') ?? '', total: o.getNumber('total') ?? 0, items: items, createdAt: o.getNumber('createdAt') ?? 0 })
					}
				}
			}
		}
		return list
	}
	// 拉我的订单：silent=true 时不转圈、失败不弹错（用于 onShow / 下拉刷新的静默刷新）
	async function loadOrders(silent: boolean) {
		if (!loginOk.value) { orders.value = []; if (!silent) { ordersLoading.value = false }; return }
		if (!silent) ordersLoading.value = true
		let err = ''
		try {
			let r = await requestJson('/cf-user', { action: 'myOrders' } as UTSJSONObject)
			if (r !== null && r.getBoolean('ok') === false && (r.getString('err') ?? '').indexOf('登录') !== -1) {
				// token 失效：清掉后静默重登一次再拉一遍
				uni.removeStorageSync('xk_user_token')
				await ensureLogin()
				if (loginOk.value) {
					r = await requestJson('/cf-user', { action: 'myOrders' } as UTSJSONObject)
				} else {
					orders.value = []
					err = '登录失败，请重新登录'
					console.log('myOrders fail', err)
					if (!silent) ordersLoading.value = false
					return
				}
			}
			if (r !== null && r.getBoolean('ok') === true) {
				orders.value = parseOrders(r)
			} else {
				err = r === null ? '网络异常，请重试' : (r.getString('err') ?? '订单加载失败，请重试')
				console.log('myOrders fail', err)
			}
		} catch (e) { console.log('loadOrders fail', e); err = '网络异常，请重试' }
		if (!silent) ordersLoading.value = false
		if (!silent && err !== '' && loginOk.value) { toast(err) }
	}
	// 单次保存请求：成功返回空串，失败返回给用户看的提示文案
	async function saveOnce(): Promise<string> {
		const r = await requestJson('/cf-user', { action: 'saveProfile', profile: { name: form.name, phone: form.phone, location: form.location } } as UTSJSONObject)
		if (r === null) return '网络异常，请重试'
		if (r.getBoolean('ok') === true) return ''
		return r.getString('err') ?? '保存失败，请重试'
	}
	// 保存常用信息：姓名必填；token 失效时清 storage 静默重登一次再重试
	async function saveProfile() {
		if (saving.value) return
		if (form.name.trim() === '') { toast('请填写姓名'); return }
		saving.value = true
		let err = ''
		try {
			err = await saveOnce()
			if (err.indexOf('登录') !== -1) {
				uni.removeStorageSync('xk_user_token')
				await ensureLogin()
				err = await saveOnce()
			}
		} catch (e) { console.log('saveProfile fail', e); err = '网络异常，请重试' }
		saving.value = false
		if (err === '') { toast('已保存') } else { toast(err) }
	}
	// 「重新登录」按钮：完整重走一遍登录，成功后回填资料并刷新订单
	async function manualLogin() {
		const p = await ensureLogin()
		applyProfile(p)
		await loadOrders(false)
	}
	// 首次进入：静默登录 → 回填资料 → 拉订单
	async function fullInit() {
		const p = await ensureLogin()
		applyProfile(p)
		await loadOrders(false)
	}
	let inited = false
	// 每次页面显示（含切回本 Tab）都静默刷新订单；首次进入才做登录 + 资料回填
	onShow(() => {
		if (!inited) { inited = true; fullInit() } else { loadOrders(true) }
	})
	// 下拉刷新：重新校验登录态，资料和订单都拉最新
	async function refreshAll() {
		try {
			const p = await ensureLogin()
			applyProfile(p)
			await loadOrders(true)
		} catch (e) { console.log('refreshAll fail', e) }
		uni.stopPullDownRefresh()
	}
	onPullDownRefresh(() => { refreshAll() })
</script>

<style>
	.page { background-color: #F2F3EF; padding: 20px 20px 36px; }
	.muted { color: #6a6762; font-size: 12px; }
	.mono { font-family: monospace; }
	/* ---------- 卡片（同点单页圆角卡片） ---------- */
	.card { background-color: #FFFEFB; border: 1px solid #E7E3DA; border-radius: 16px; padding: 14px 16px 16px; margin-top: 14px; box-shadow: 0 6px 14px rgba(28,25,23,.05); }
	.card-title { display: block; color: #8A8F82; font-size: 11px; font-weight: 700; letter-spacing: .2em; margin-bottom: 8px; }
	/* ---------- 登录态卡 ---------- */
	.login-card { display: flex; flex-direction: row; align-items: center; margin-top: 0; }
	.avatar { width: 46px; height: 46px; border-radius: 10px; background-color: #C2410C; background-image: linear-gradient(180deg, #D4511B, #C2410C 55%, #9A3412); display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 14px rgba(194,65,12,.3); }
	.avatar-char { color: #FFFEFB; font-family: serif; font-size: 22px; font-weight: 900; }
	.login-main { flex: 1; margin-left: 11px; }
	.login-title { display: block; font-size: 15px; font-weight: 700; color: #1C1917; }
	.login-err { display: block; color: #C2410C; font-size: 11.5px; margin-top: 4px; }
	.relogin { width: 96px; height: 38px; background-color: #FFFEFB; border: 1px solid #E7E3DA; border-radius: 12px; font-size: 12.5px; font-weight: 700; color: #57534E; margin: 0; padding: 0; }
	/* ---------- 常用信息 ---------- */
	.form-field { margin-top: 12px; }
	.form-label-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 6px; }
	.form-label { color: #57534E; font-size: 12px; font-weight: 700; letter-spacing: .05em; }
	.req { color: #C2410C; font-size: 12px; margin-left: 3px; }
	.form-field input { width: 100%; height: 46px; box-sizing: border-box; padding: 0 12px; background-color: #FFFEFB; border: 1px solid #E7E3DA; border-radius: 11px; font-size: 14px; }
	.ph { color: #B8B2A8; }
	.primary { width: 100%; height: 48px; background-color: #C2410C; background-image: linear-gradient(180deg, #D4511B, #C2410C 55%, #9A3412); color: #FFFEFB; border: 0; border-radius: 14px; font-size: 15px; font-weight: 700; letter-spacing: .12em; margin-top: 16px; box-shadow: 0 8px 18px rgba(194,65,12,.3); }
	.primary[disabled] { background-color: #C9C4BB; background-image: none; color: #F2F3EF; box-shadow: none; }
	/* ---------- 我的订单 ---------- */
	.order-item { border-top: 1px dashed #E7E3DA; padding: 10px 0 2px; }
	.order-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
	.order-no { font-size: 12px; font-weight: 700; color: #57534E; }
	.oc-status { border-radius: 7px; padding: 3px 9px; font-size: 11px; font-weight: 700; }
	.st-pending { background-color: #FDF1E8; color: #C2410C; }
	.st-cooking { background-color: #1C1917; color: #FDBA74; }
	.st-ready { background-color: #E8F6EC; color: #2E7D32; }
	.st-cancel { background-color: #EDEAE3; color: #79716B; }
	.order-line { display: flex; flex-direction: row; justify-content: space-between; padding: 7px 0; border-bottom: 1px dashed #E7E3DA; }
	.order-line-name { font-size: 13px; color: #44403C; }
	.order-line-price { font-size: 13px; font-weight: 800; color: #1C1917; }
	.order-foot { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding-top: 8px; }
	.order-time { font-size: 11px; color: #A8A29E; }
	.order-total-row { display: flex; flex-direction: row; align-items: baseline; }
	.order-total-label { font-size: 12px; color: #79716B; margin-right: 6px; }
	.order-total-num { font-size: 15px; font-weight: 800; color: #C2410C; }
	.order-empty { display: block; text-align: center; padding: 10px 0 4px; }
	.foot-note { display: block; text-align: center; color: #B8B2A8; font-size: 11px; margin-top: 18px; }
	/* ---------- 提示 ---------- */
	.toast { position: fixed; left: 20%; right: 20%; bottom: 100px; background-color: rgba(28,25,23,.88); color: #FFFEFB; padding: 10px; border-radius: 10px; text-align: center; font-size: 13px; }
</style>
