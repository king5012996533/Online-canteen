<template>
	<view class="page">
		<!-- 用户卡 -->
		<view class="card user-card">
			<view class="avatar-wrap">
				<image v-if="customer.avatar_url !== ''" class="avatar-img" :src="customer.avatar_url" mode="aspectFill"></image>
				<text v-else class="avatar-letter">{{avatarLetter}}</text>
			</view>
			<view class="user-main">
				<text class="user-name">{{displayName}}</text>
				<text class="user-sub">{{subLine}}</text>
				<text v-if="loginErr !== ''" class="login-err">{{loginErr}}</text>
			</view>
		</view>

		<!-- 一键登录（未登录时） -->
		<button v-if="!loggedIn" class="g-btn-primary login-btn" :disabled="loginChecking" @click="doLogin">{{loginChecking ? '登录中…' : '微信一键登录'}}</button>
		<view v-if="!loggedIn" class="login-tip"><text class="g-sub">登录后可下单、同步常用信息。一键登录由微信静默完成，不会打扰你。</text></view>

		<!-- 完善资料（已登录且未设昵称） -->
		<view v-if="loggedIn && customer.nickname === ''" class="card edit-card">
			<text class="g-cap edit-cap">完善资料</text>
			<view class="g-hairline edit-line"></view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">昵称</text><text class="g-req">*</text></view><input class="g-field-input" v-model="nicknameInput" placeholder="给自己起个名字" placeholder-class="g-ph" maxlength="20" /></view>
			<button class="g-btn-primary save-btn" :disabled="saving" @click="saveNickname">{{saving ? '保存中…' : '保存'}}</button>
		</view>

		<!-- 头像昵称卡（点菜单行展开修改） -->
		<view v-if="editingProfile" class="card edit-card">
			<text class="g-cap edit-cap">头像与昵称</text>
			<view class="g-hairline edit-line"></view>
			<view class="avatar-edit-row">
				<view class="avatar-wrap">
					<image v-if="customer.avatar_url !== ''" class="avatar-img" :src="customer.avatar_url" mode="aspectFill"></image>
					<text v-else class="avatar-letter big">{{avatarLetter}}</text>
				</view>
				<button class="avatar-pick" @click="pickAvatar">更换头像</button>
			</view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">昵称</text></view><input class="g-field-input" v-model="nicknameInput" placeholder-class="g-ph" maxlength="20" /></view>
			<button class="g-btn-primary save-btn" :disabled="saving" @click="saveProfileInfo">{{saving ? '保存中…' : '保存'}}</button>
		</view>

		<!-- 菜单卡（需登录：订单/地址/电话都跟账号走） -->
		<view v-if="loggedIn" class="card menu-card">
			<view class="menu-row" @click="goOrders">
				<image class="row-ic" src="/static/tab/orders.png" mode="aspectFit"></image>
				<text class="row-text">我的订单</text>
				<text class="row-arr">›</text>
			</view>
			<view class="menu-row" @click="toggleProfileEdit">
				<image class="row-ic" src="/static/tab/me.png" mode="aspectFit"></image>
				<text class="row-text">头像与昵称</text>
				<text class="row-val">{{customer.nickname || '未设置'}}</text>
				<text class="row-arr">›</text>
			</view>
			<view class="menu-row" @click="toggleEdit">
				<image class="row-ic" src="/static/icons/pin.png" mode="aspectFit"></image>
				<text class="row-text">配送地址</text>
				<text class="row-val">{{form.location || '未填写'}}</text>
				<text class="row-arr">›</text>
			</view>
			<view class="menu-row" @click="toggleEdit">
				<image class="row-ic" src="/static/icons/phone.png" mode="aspectFit"></image>
				<text class="row-text">联系电话</text>
				<text class="row-val">{{form.phone || '未填写'}}</text>
				<text class="row-arr">›</text>
			</view>
		</view>

		<!-- 编辑卡（点地址/电话行展开） -->
		<view v-if="editing" class="card edit-card">
			<text class="g-cap edit-cap">常用信息 · 配送与联系</text>
			<view class="g-hairline edit-line"></view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">配送联系人</text><text class="g-req">*</text></view><input class="g-field-input" v-model="form.name" placeholder="如：张三 / 3 楼财务" placeholder-class="g-ph" maxlength="20" /></view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">联系电话（选填）</text></view><input class="g-field-input" v-model="form.phone" type="number" placeholder="138 0000 0000" placeholder-class="g-ph" maxlength="11" /></view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">常用配送地点（选填）</text><text class="loc-pick" @click="pickMapLocation">地图选点</text></view><input class="g-field-input" v-model="form.location" placeholder="如：XX大厦 / 公司前台" placeholder-class="g-ph" maxlength="40" /></view>
			<button class="g-btn-primary save-btn" :disabled="saving" @click="saveContact">{{saving ? '保存中…' : '保存'}}</button>
		</view>

		<!-- 关于我们 -->
		<view class="card menu-card">
			<button class="menu-row contact-row" open-type="contact">
				<image class="row-ic" src="/static/icons/chat.png" mode="aspectFit"></image>
				<text class="row-text">意见反馈</text>
				<text class="row-arr">›</text>
			</button>
			<view class="menu-row" @click="aboutTip">
				<image class="row-ic" src="/static/icons/info.png" mode="aspectFit"></image>
				<text class="row-text">关于我们</text>
				<text class="row-arr">›</text>
			</view>
		</view>

		<!-- 退出登录 -->
		<view v-if="loggedIn" class="card out-card" @click="logoutBtn"><text class="out-text">退出登录</text></view>

		<!-- 关于我们 -->
		<view v-if="aboutSheet" class="sheet-mask"><view class="sheet">
			<text class="sheet-title">关于我们</text>
			<text class="about-name">富记线上饭堂</text>
			<text class="about-line">写字楼现炒午餐 · 每日菜单 · 按价格选份量</text>
			<view class="g-hairline about-line-sep"></view>
			<view class="about-row"><text class="about-k">午餐配送</text><text class="about-v">{{cfgOf('lunch').deliveryLabel}}</text></view>
			<view class="about-row"><text class="about-k">晚餐配送</text><text class="about-v">{{cfgOf('dinner').deliveryLabel}}</text></view>
			<button class="g-btn-primary about-btn" @click="aboutSheet = false">知道了</button>
		</view></view>

		<view v-if="toastMessage !== ''" class="g-toast"><text class="toast-text">{{toastMessage}}</text></view>
	</view>
</template>

<script setup lang="uts">
	import { customer, loggedIn, loginChecking, loginErr, sessionRestore, login, logout, saveProfileFields, pickLocationText } from '../../common/session.uts'
	import { cfgOf } from '../../common/meals.uts'

	const toastMessage = ref('')
	const nicknameInput = ref('')
	const editing = ref(false)
	const editingProfile = ref(false)
	const aboutSheet = ref(false)
	const saving = ref(false)
	const form = reactive({ name: '', phone: '', location: '' })

	function toast(msg: string) { toastMessage.value = msg; setTimeout(() => { toastMessage.value = '' }, 1800) }

	const displayName = computed((): string => {
		if (!loggedIn.value) return '未登录'
		if (customer.nickname !== '') return customer.nickname
		if (customer.name !== '') return customer.name
		return '微信用户'
	})
	const subLine = computed((): string => {
		if (!loggedIn.value) return '登录后可下单并同步常用信息'
		return customer.location !== '' ? customer.location : 'XX大厦 / 公司前台'
	})
	const avatarLetter = computed((): string => {
		const src = customer.nickname !== '' ? customer.nickname : (customer.name !== '' ? customer.name : '微')
		return src.charAt(0)
	})

	// 微信一键登录
	async function doLogin() {
		if (loginChecking.value) return
		const ok = await login()
		if (ok) { toast('登录成功') }
	}

	// 保存昵称（首次完善资料）
	async function saveNickname() {
		if (saving.value) return
		const nick = nicknameInput.value.trim()
		if (nick === '') { toast('请填写昵称'); return }
		saving.value = true
		const ok = await saveProfileFields(nick, customer.avatar_url, customer.name, customer.phone, customer.location)
		saving.value = false
		toast(ok ? '已保存' : '保存失败，请重试')
	}
	// 保存头像+昵称
	async function saveProfileInfo() {
		if (saving.value) return
		const nick = nicknameInput.value.trim()
		if (nick === '') { toast('请填写昵称'); return }
		saving.value = true
		const ok = await saveProfileFields(nick, customer.avatar_url, customer.name, customer.phone, customer.location)
		saving.value = false
		toast(ok ? '已保存' : '保存失败，请重试')
	}
	// 更换头像：相册选图 → 上传云存储 → 保存档案
	async function pickAvatar() {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				const path = res.tempFilePaths.length > 0 ? res.tempFilePaths[0] : ''
				if (path === '') return
				uniCloud.uploadFile({
					filePath: path,
					cloudPath: 'avatars/' + Date.now().toString(36) + '.jpg',
					success: async (up) => {
						try {
							const tf = await uniCloud.getTempFileURL({ fileList: [up.fileID] })
							let url = ''
							if (tf.fileList.length > 0) { url = tf.fileList[0].tempFileURL }
							if (url === '') { toast('头像上传失败，请重试'); return }
							customer.avatar_url = url
							const ok = await saveProfileFields(customer.nickname, url, customer.name, customer.phone, customer.location)
							toast(ok ? '头像已更新' : '头像已上传，档案保存失败')
						} catch (e) { console.log('avatar tempUrl fail', e); toast('头像地址获取失败') }
					},
					fail: () => { toast('头像上传失败，请重试') }
				})
			}
		})
	}
	// 保存配送联系信息
	async function saveContact() {
		if (saving.value) return
		if (form.name.trim() === '') { toast('请填写配送联系人'); return }
		saving.value = true
		const ok = await saveProfileFields(customer.nickname, customer.avatar_url, form.name.trim(), form.phone.trim(), form.location.trim())
		saving.value = false
		toast(ok ? '已保存' : '保存失败，请重试')
	}
	function toggleEdit() {
		editing.value = !editing.value
		if (editing.value) {
			form.name = customer.name
			form.phone = customer.phone
			form.location = customer.location
		}
	}
	// 头像与昵称编辑卡展开/收起（展开时回填当前昵称，避免页面常驻显示第二份昵称）
	function toggleProfileEdit() {
		editingProfile.value = !editingProfile.value
		if (editingProfile.value) { nicknameInput.value = customer.nickname }
	}
	// 地图选点：选中回填表单（点保存才落库）
	async function pickMapLocation() {
		const v = await pickLocationText()
		if (v === '') { toast('未选择位置'); return }
		form.location = v
	}
	function goOrders() { uni.switchTab({ url: '/pages/orders/orders' }) }
	function aboutTip() { aboutSheet.value = true }
	// 退出登录：清掉本地 token 与登录态；下次进入点「一键登录」即可恢复
	function logoutBtn() {
		logout()
		editing.value = false
		toast('已退出，下次进入点「一键登录」即可')
	}

	onLoad(() => { sessionRestore() })
	onPullDownRefresh(() => { uni.stopPullDownRefresh() })
</script>

<style>
	.page { background-color: #F6F3EB; padding: 20px 20px 36px; }
	.card { background-color: #FFFFFF; border-radius: 16px; border: 1px solid #E7E3D6; }
	/* ---------- 用户卡 ---------- */
	.user-card { display: flex; flex-direction: row; align-items: center; padding: 16px 14px; margin-top: 8px; }
	.avatar-wrap { width: 52px; height: 52px; border-radius: 26px; background-color: #E9F1E7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
	.avatar-img { width: 52px; height: 52px; }
	.avatar-letter { color: #2F6B3F; font-size: 20px; font-weight: 900; }
	.avatar-letter.big { font-size: 30px; }
	.user-main { flex: 1; min-width: 0; margin-left: 12px; }
	.user-name { display: block; font-size: 17px; font-weight: 900; color: #22301F; }
	.user-sub { display: block; font-size: 11.5px; color: #8C9689; margin-top: 4px; }
	.login-err { display: block; color: #C8862A; font-size: 11px; margin-top: 4px; }
	/* ---------- 一键登录 ---------- */
	.login-btn { width: 100%; margin-top: 16px; }
	.login-tip { margin-top: 10px; text-align: center; line-height: 1.6; padding: 0 10px; }
	/* ---------- 编辑卡 ---------- */
	.edit-card { margin-top: 14px; padding: 14px; }
	.edit-cap { display: block; margin-bottom: 4px; }
	.edit-line { margin-bottom: 6px; }
	.form-field { margin-top: 12px; }
	.form-label-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 6px; }
	.loc-pick { margin-left: auto; font-size: 11.5px; font-weight: 700; color: #2F6B3F; }
	.save-btn { width: 100%; border: 0; margin-top: 16px; }
	.avatar-edit-row { display: flex; flex-direction: row; align-items: center; margin-top: 4px; }
	.avatar-pick { margin-left: 12px; background-color: #F3F7F1; border: 0; border-radius: 999px; padding: 7px 14px; font-size: 12px; font-weight: 700; color: #22301F; }
	/* ---------- 菜单卡 ---------- */
	.menu-card { margin-top: 14px; padding: 2px 14px; }
	.menu-row { display: flex; flex-direction: row; align-items: center; padding: 13px 0; border-bottom: 1px solid #E7E3D6; }
	.row-ic { width: 20px; height: 20px; margin-right: 11px; flex-shrink: 0; }
	.row-text { font-size: 13.5px; font-weight: 600; color: #22301F; }
	.row-val { margin-left: auto; font-size: 11.5px; color: #8C9689; font-weight: 600; }
	.row-arr { margin-left: 8px; color: #C4CCBF; font-size: 15px; }
	/* 意见反馈：微信客服会话按钮 */
	.contact-row { background-color: #FFFFFF; border: 0; margin: 0; width: 100%; border-radius: 0; }
	/* ---------- 关于我们 ---------- */
	.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(20,20,24,0.32); display: flex; align-items: flex-end; }
	.sheet { background-color: #FFFFFF; width: 100%; padding: 20px; border-radius: 22px 22px 0 0; }
	.sheet-title { display: block; font-size: 20px; font-weight: 900; margin-bottom: 6px; color: #22301F; }
	.about-name { display: block; font-size: 17px; font-weight: 900; color: #2F6B3F; margin-top: 8px; }
	.about-line { display: block; font-size: 12px; color: #8C9689; margin-top: 4px; }
	.about-line-sep { margin-top: 12px; }
	.about-row { display: flex; flex-direction: row; justify-content: space-between; padding: 8px 0; }
	.about-k { font-size: 12px; color: #8C9689; }
	.about-v { font-size: 12px; font-weight: 700; color: #22301F; }
	.about-btn { width: 100%; border: 0; margin-top: 14px; }
	/* ---------- 退出登录 ---------- */
	.out-card { margin-top: 18px; padding: 13px; display: flex; align-items: center; justify-content: center; }
	.out-text { font-size: 13px; font-weight: 700; color: #8C9689; }
	/* ---------- 轻提示 ---------- */
	.toast-text { color: #FFFFFF; font-size: 13px; text-align: center; }
</style>
