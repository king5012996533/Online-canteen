<template>
	<view class="page">
		<!-- 用户卡：头像 + 名称 + 配送地点 -->
		<view class="card user-card">
			<view class="avatar"><text class="avatar-char">微</text></view>
			<view class="user-main">
				<text class="user-name">{{userDisplayName}}</text>
				<text class="user-sub">{{userSubLine}}</text>
				<text v-if="!loginOk && !loginChecking && loginErr !== ''" class="login-err">{{loginErr}}</text>
			</view>
			<button v-if="!loginOk && !loginChecking" class="g-btn-ghost relogin" @click="manualLogin">重新登录</button>
		</view>

		<!-- 菜单卡：图标行 -->
		<view class="card menu-card">
			<view class="menu-row" @click="goOrders">
				<image class="row-ic" src="/static/tab/orders.png" mode="aspectFit"></image>
				<text class="row-text">我的订单</text>
				<text class="row-arr">›</text>
			</view>
			<view class="menu-row" @click="toggleEdit">
				<image class="row-ic" src="/static/icons/pin.png" mode="aspectFit"></image>
				<text class="row-text">配送地址</text>
				<text class="row-val">{{form.location || '未填写'}}</text>
				<text class="row-arr">›</text>
			</view>
			<view class="menu-row" @click="toggleEdit">
				<image class="row-ic" src="/static/icons/phone.png" mode="aspectFit"></image>
				<text class="row-text">联系电话</text>
				<text class="row-val">{{form.phone || '未填写'}}</text>
				<text class="row-arr">›</text>
			</view>
			<button class="menu-row contact-row" open-type="contact">
				<image class="row-ic" src="/static/icons/chat.png" mode="aspectFit"></image>
				<text class="row-text">意见反馈</text>
				<text class="row-arr">›</text>
			</button>
			<view class="menu-row" @click="aboutTip">
				<image class="row-ic" src="/static/icons/info.png" mode="aspectFit"></image>
				<text class="row-text">关于我们</text>
				<text class="row-arr">›</text>
			</view>
		</view>

		<!-- 编辑卡：点地址/电话行展开 -->
		<view v-if="editing" class="card edit-card">
			<text class="g-cap edit-cap">常用信息 · 配送与联系</text>
			<view class="g-hairline edit-line"></view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">姓名</text><text class="g-req">*</text></view><input class="g-field-input" v-model="form.name" placeholder="如：张三 / 3 楼财务" placeholder-class="g-ph" /></view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">联系电话（选填）</text></view><input class="g-field-input" v-model="form.phone" type="number" placeholder="138 0000 0000" placeholder-class="g-ph" /></view>
			<view class="form-field"><view class="form-label-row"><text class="g-label">常用配送地点（选填）</text></view><input class="g-field-input" v-model="form.location" placeholder="如：XX大厦 / 公司前台" placeholder-class="g-ph" /></view>
			<button class="g-btn-primary save-btn" :disabled="saving" @click="saveProfile">{{saving ? '保存中…' : '保存'}}</button>
		</view>

		<!-- 退出登录 -->
		<view class="card out-card" @click="logout"><text class="out-text">退出登录</text></view>

		<!-- 关于我们 -->
		<view v-if="aboutSheet" class="sheet-mask"><view class="sheet">
			<text class="sheet-title">关于我们</text>
			<text class="about-name">富记线上饭堂</text>
			<text class="about-line">写字楼现炒午餐 · 每日菜单 · 按价格选份量</text>
			<view class="g-hairline about-line-sep"></view>
			<view class="about-row"><text class="about-k">午餐配送</text><text class="about-v">{{cfgOf('lunch').deliveryLabel}}</text></view>
			<view class="about-row"><text class="about-k">晚餐配送</text><text class="about-v">{{cfgOf('dinner').deliveryLabel}}</text></view>
			<button class="g-btn-primary about-btn" @click="aboutSheet = false">知道了</button>
		</view></view>

		<view v-if="toastMessage !== ''" class="g-toast"><text class="toast-text">{{toastMessage}}</text></view>
	</view>
</template>

<script setup lang="uts">
	import { requestJson } from '../../common/http.uts'
	import { cfgOf } from '../../common/meals.uts'

	type OrderItem = { name: string; pay: number; qty: number }
	type MyOrder = { orderNo: string; status: string; total: number; items: OrderItem[]; createdAt: number }

	// 登录态：loginOk 已登录 / loginChecking 登录中 / 失败时 loginErr 给出原因
	const loginOk = ref(false)
	const loginChecking = ref(true)
	const loginErr = ref('')
	const form = reactive({name: '', phone: '', location: ''})
	const saving = ref(false)
	const orders = ref<MyOrder[]>([])
	const ordersLoading = ref(true)
	const toastMessage = ref('')
	// 编辑态：点「配送地址/联系电话」行展开常用信息编辑卡
	const editing = ref(false)
	const aboutSheet = ref(false)

	function toast(msg: string) { toastMessage.value = msg; setTimeout(() => { toastMessage.value = '' }, 1800) }
	function pad2(n: number): string { return n < 10 ? '0' + n : '' + n }
	// 北京时间格式化下单时间（与 index 页 bjNow 同一换算口径）
	function fmtTime(ms: number): string {
		const d = new Date(ms + (480 + new Date(ms).getTimezoneOffset()) * 60000)
		return pad2(d.getUTCMonth() + 1) + '-' + pad2(d.getUTCDate()) + ' ' + pad2(d.getUTCHours()) + ':' + pad2(d.getUTCMinutes())
	}
	// 状态文案：4.0 配送语义（ready=待配送，delivering=配送中），delivered 为云端新增状态
	function statusText(s: string): string { if (s === 'cooking') return '制作中'; if (s === 'ready') return '待配送'; if (s === 'delivering') return '配送中'; if (s === 'delivered') return '已送达'; if (s === 'canceled') return '已取消'; return '待处理' }
	function statusClass(s: string): string { if (s === 'cooking') return 'st-cooking'; if (s === 'ready') return 'st-cooking'; if (s === 'delivering') return 'st-ready'; if (s === 'delivered') return 'st-delivered'; if (s === 'canceled') return 'st-cancel'; return 'st-pending' }

	// 用户卡文案
	const userDisplayName = computed((): string => {
		if (loginChecking.value) return '正在登录…'
		if (!loginOk.value) return '未登录'
		const name = customerName()
		return name === '' ? '微信用户' : name
	})
	const userSubLine = computed((): string => {
		if (!loginOk.value) return '富记线上饭堂 · 写字楼现炒午餐'
		const loc = customerLocation()
		return loc === '' ? 'XX大厦 / 公司前台' : loc
	})
	function customerName(): string { return customer.name }
	function customerLocation(): string { return customer.location }

	function toggleEdit() { editing.value = !editing.value }
	function goOrders() { uni.switchTab({ url: '/pages/orders/orders' }) }
	function aboutTip() { aboutSheet.value = true }
	// 退出登录：清掉本地 token 与登录态；下次进入会自动重新静默登录
	function logout() {
		uni.removeStorageSync('xk_user_token')
		loginOk.value = false
		loginChecking.value = false
		loginErr.value = ''
		orders.value = []
		toast('已退出，下次进入将自动重新登录')
	}

	// uni.login 回调转 Promise：拿微信登录 code（拿不到返回空串）
	function getWxCode(): Promise<string> {
		return new Promise<string>((resolve) => {
			uni.login({
				provider: 'weixin',
				success: (res) => { resolve(res.code ?? '') },
				fail: (err) => { console.log('uni.login fail', err); resolve('') }
			})
		})
	}
	// 从 data 里取资料（login / getProfile 两种响应都带 data.profile）
	function pickProfile(data: UTSJSONObject): UTSJSONObject | null {
		const p = data.getJSON('profile')
		if (p instanceof UTSJSONObject) return p
		return null
	}
	// 静默登录全流程：有 token 先验（getProfile）→ 失效清掉重登一次；无 token 直接微信登录。
	// 整个流程静默不弹窗，失败只把登录态卡标成未登录。成功返回资料（可能为 null）
	async function ensureLogin(): Promise<UTSJSONObject | null> {
		if (!loginOk.value) { loginChecking.value = true }
		loginErr.value = ''
		try {
			const t = uni.getStorageSync('xk_user_token')
			if (t !== '' && t !== null) {
				const r = await requestJson('/cf-user', { action: 'getProfile' } as UTSJSONObject)
				if (r !== null && r.getBoolean('ok') === true) {
					const d = r.getJSON('data')
					if (d instanceof UTSJSONObject) {
						loginOk.value = true
						loginChecking.value = false
						return pickProfile(d)
					}
					loginChecking.value = false
					return null
				}
				if (r !== null && (r.getString('err') ?? '').indexOf('登录') !== -1) {
					// token 失效：清掉后走一次重新登录
					uni.removeStorageSync('xk_user_token')
				} else {
					loginChecking.value = false
					loginErr.value = r !== null ? (r.getString('err') ?? '登录失败') : '网络异常，请检查网络'
					return null
				}
			}
			// 无 token / token 刚失效：微信静默登录换新 token
			const code = await getWxCode()
			if (code === '') { loginChecking.value = false; loginErr.value = '微信登录失败，请重试'; return null }
			const r2 = await requestJson('/cf-user', { action: 'login', code: code } as UTSJSONObject)
			if (r2 !== null && r2.getBoolean('ok') === true) {
				const d2 = r2.getJSON('data')
				if (d2 instanceof UTSJSONObject) {
					const token = d2.getString('token') ?? ''
					if (token !== '') { uni.setStorageSync('xk_user_token', token) }
					loginOk.value = true
					loginChecking.value = false
					return pickProfile(d2)
				}
			}
			loginChecking.value = false
			loginErr.value = r2 !== null ? (r2.getString('err') ?? '登录失败，请重试') : '网络异常，请检查网络'
			console.log('ensureLogin fail', loginErr.value)
			return null
		} catch (e) {
			console.log('ensureLogin fail', e)
			loginChecking.value = false
			loginErr.value = '登录失败，请重试'
			return null
		}
	}
	// 把服务端资料回填到输入框（进入页面/下拉刷新时以服务端为准）
	function applyProfile(p: UTSJSONObject | null) {
		if (p === null) return
		form.name = p.getString('name') ?? ''
		form.phone = p.getString('phone') ?? ''
		form.location = p.getString('location') ?? ''
	}
	// 解析 myOrders 响应里的订单数组
	function parseOrders(r: UTSJSONObject): MyOrder[] {
		const list: MyOrder[] = []
		const data = r.getJSON('data')
		if (data instanceof UTSJSONObject) {
			const arr = data.getArray('orders')
			if (arr !== null) {
				for (let i = 0; i < arr.length; i++) {
					const o = arr[i]
					if (o instanceof UTSJSONObject) {
						const items: OrderItem[] = []
						const iarr = o.getArray('items')
						if (iarr !== null) {
							for (let j = 0; j < iarr.length; j++) {
								const it = iarr[j]
								if (it instanceof UTSJSONObject) {
									items.push({ name: it.getString('name') ?? '', pay: it.getNumber('pay') ?? 0, qty: Math.floor(it.getNumber('qty') ?? 0) })
								}
							}
						}
						list.push({ orderNo: o.getString('orderNo') ?? '', status: o.getString('status') ?? '', total: o.getNumber('total') ?? 0, items: items, createdAt: o.getNumber('createdAt') ?? 0 })
					}
				}
			}
		}
		return list
	}
	// 拉我的订单：silent=true 时不转圈、失败不弹错（用于 onShow / 下拉刷新的静默刷新）
	async function loadOrders(silent: boolean) {
		if (!loginOk.value) { orders.value = []; if (!silent) { ordersLoading.value = false }; return }
		if (!silent) ordersLoading.value = true
		let err = ''
		try {
			let r = await requestJson('/cf-user', { action: 'myOrders' } as UTSJSONObject)
			if (r !== null && r.getBoolean('ok') === false && (r.getString('err') ?? '').indexOf('登录') !== -1) {
				// token 失效：清掉后静默重登一次再拉一遍
				uni.removeStorageSync('xk_user_token')
				await ensureLogin()
				if (loginOk.value) {
					r = await requestJson('/cf-user', { action: 'myOrders' } as UTSJSONObject)
				} else {
					orders.value = []
					err = '登录失败，请重新登录'
					console.log('myOrders fail', err)
					if (!silent) ordersLoading.value = false
					return
				}
			}
			if (r !== null && r.getBoolean('ok') === true) {
				orders.value = parseOrders(r)
			} else {
				err = r === null ? '网络异常，请重试' : (r.getString('err') ?? '订单加载失败，请重试')
				console.log('myOrders fail', err)
			}
		} catch (e) { console.log('loadOrders fail', e); err = '网络异常，请重试' }
		if (!silent) ordersLoading.value = false
		if (!silent && err !== '' && loginOk.value) { toast(err) }
	}
	// 单次保存请求：成功返回空串，失败返回给用户看的提示文案
	async function saveOnce(): Promise<string> {
		const r = await requestJson('/cf-user', { action: 'saveProfile', profile: { name: form.name, phone: form.phone, location: form.location } } as UTSJSONObject)
		if (r === null) return '网络异常，请重试'
		if (r.getBoolean('ok') === true) return ''
		return r.getString('err') ?? '保存失败，请重试'
	}
	// 保存常用信息：姓名必填；token 失效时清 storage 静默重登一次再重试
	async function saveProfile() {
		if (saving.value) return
		if (form.name.trim() === '') { toast('请填写姓名'); return }
		saving.value = true
		let err = ''
		try {
			err = await saveOnce()
			if (err.indexOf('登录') !== -1) {
				uni.removeStorageSync('xk_user_token')
				await ensureLogin()
				err = await saveOnce()
			}
		} catch (e) { console.log('saveProfile fail', e); err = '网络异常，请重试' }
		saving.value = false
		if (err === '') { toast('已保存') } else { toast(err) }
	}
	// 「重新登录」按钮：完整重走一遍登录，成功后回填资料并刷新订单
	async function manualLogin() {
		const p = await ensureLogin()
		applyProfile(p)
		await loadOrders(false)
	}
	// 首次进入：静默登录 → 回填资料 → 拉订单
	async function fullInit() {
		const p = await ensureLogin()
		applyProfile(p)
		await loadOrders(false)
	}
	let inited = false
	// 每次页面显示（含切回本 Tab）都静默刷新订单；首次进入才做登录 + 资料回填
	onShow(() => {
		if (!inited) { inited = true; fullInit() } else { loadOrders(true) }
	})
	// 下拉刷新：重新校验登录态，资料和订单都拉最新
	async function refreshAll() {
		try {
			const p = await ensureLogin()
			applyProfile(p)
			await loadOrders(true)
		} catch (e) { console.log('refreshAll fail', e) }
		uni.stopPullDownRefresh()
	}
	onPullDownRefresh(() => { refreshAll() })
</script>

<style>
	.page { background-color: #F6F3EB; padding: 20px 20px 36px; }
	.card { background-color: #FFFFFF; border-radius: 16px; border: 1px solid #E7E3D6; }
	/* ---------- 用户卡 ---------- */
	.user-card { display: flex; flex-direction: row; align-items: center; padding: 16px 14px; margin-top: 8px; }
	.avatar { width: 52px; height: 52px; border-radius: 26px; background-color: #E9F1E7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
	.avatar-char { color: #2F6B3F; font-size: 20px; font-weight: 900; }
	.user-main { flex: 1; min-width: 0; margin-left: 12px; }
	.user-name { display: block; font-size: 17px; font-weight: 900; color: #22301F; }
	.user-sub { display: block; font-size: 11.5px; color: #8C9689; margin-top: 4px; }
	.login-err { display: block; color: #C8862A; font-size: 11px; margin-top: 4px; }
	.relogin { width: 96px; height: 38px; font-size: 12.5px; margin-left: 12px; flex-shrink: 0; }
	/* ---------- 菜单卡 ---------- */
	.menu-card { margin-top: 14px; padding: 2px 14px; }
	.menu-row { display: flex; flex-direction: row; align-items: center; padding: 13px 0; border-bottom: 1px solid #E7E3D6; }
	.menu-row:last-child { border-bottom: 0; }
	.row-ic { width: 20px; height: 20px; margin-right: 11px; flex-shrink: 0; }
	.row-text { font-size: 13.5px; font-weight: 600; color: #22301F; }
	.row-val { margin-left: auto; font-size: 11.5px; color: #8C9689; font-weight: 600; }
	.row-arr { margin-left: 8px; color: #C4CCBF; font-size: 15px; }
	/* ---------- 编辑卡 ---------- */
	.edit-card { margin-top: 14px; padding: 14px; }
	.edit-cap { display: block; margin-bottom: 4px; }
	.edit-line { margin-bottom: 6px; }
	.form-field { margin-top: 12px; }
	.form-label-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 6px; }
	.save-btn { width: 100%; border: 0; margin-top: 16px; }
	/* ---------- 菜单行（意见反馈为微信客服会话按钮） ---------- */
	.contact-row { background-color: #FFFFFF; border: 0; margin: 0; width: 100%; border-radius: 0; }
	.menu-row:last-child { border-bottom: 0; }
	.contact-row:last-child { border-bottom: 0; }
	/* ---------- 关于我们 ---------- */
	.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(20,20,24,0.32); display: flex; align-items: flex-end; }
	.sheet { background-color: #FFFFFF; width: 100%; padding: 20px; border-radius: 22px 22px 0 0; }
	.sheet-title { display: block; font-size: 20px; font-weight: 900; margin-bottom: 6px; color: #22301F; }
	.about-name { display: block; font-size: 17px; font-weight: 900; color: #2F6B3F; margin-top: 8px; }
	.about-line { display: block; font-size: 12px; color: #8C9689; margin-top: 4px; }
	.about-line-sep { margin-top: 12px; }
	.about-row { display: flex; flex-direction: row; justify-content: space-between; padding: 8px 0; }
	.about-k { font-size: 12px; color: #8C9689; }
	.about-v { font-size: 12px; font-weight: 700; color: #22301F; }
	.about-btn { width: 100%; border: 0; margin-top: 14px; }
	/* ---------- 退出登录 ---------- */
	.out-card { margin-top: 18px; padding: 13px; display: flex; align-items: center; justify-content: center; }
	.out-text { font-size: 13px; font-weight: 700; color: #8C9689; }
	/* ---------- 轻提示 ---------- */
	.toast-text { color: #FFFFFF; font-size: 13px; text-align: center; }
</style>
