	function hexVal(s: string): number {
		let v = 0
		for (let i = 0; i < s.length; i++) {
			const c = s.charCodeAt(i)
			let d = -1
			if (c >= 48 && c <= 57) { d = c - 48 }
			else if (c >= 65 && c <= 70) { d = c - 55 }
			else if (c >= 97 && c <= 102) { d = c - 87 }
			if (d < 0) { return -1 }
			v = v * 16 + d
		}
		return v
	}

	var GBK_MAP: Map<number, Array<number>> | null = null
	export function ensureGbk(): Map<number, Array<number>> {
		if (GBK_MAP !== null) { return GBK_MAP }
		const m = new Map<number, Array<number>>()
		let i = 0
		while (i + 8 <= GBK_DATA.length) {
			const u = hexVal(GBK_DATA.substring(i, i + 4))
			const b1 = hexVal(GBK_DATA.substring(i + 4, i + 6))
			const b2 = hexVal(GBK_DATA.substring(i + 6, i + 8))
			if (u >= 0 && b1 >= 0) {
				if (b2 === 0) { m.set(u, [b1]) }
				else if (b2 > 0) { m.set(u, [b1, b2]) }
			}
			i += 9
		}
		GBK_MAP = m
		return m
	}
