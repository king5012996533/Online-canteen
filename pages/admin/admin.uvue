<template>
	<view class="page">
		<!-- 口令门 -->
		<view v-if="showGate" class="gate">
			<view class="gate-card">
				<view class="seal"><text class="seal-char">富</text></view>
				<text class="gate-title">富记厨房端</text>
				<text class="gate-sub">内部管理入口 · 请输入访问口令</text>
				<input class="gate-input" type="password" v-model="passInput" placeholder="访问口令" placeholder-class="ph" />
				<text v-if="gateErr !== ''" class="gate-err">{{gateErr}}</text>
				<button class="primary" @click="submitGate">{{checking ? '验证中…' : '进入'}}</button>
			</view>
		</view>

		<!-- 主面板：左侧导航 + 右侧视图 -->
		<view v-else class="shell">
			<view class="side">
				<view class="side-logo"><text class="side-logo-char">富</text></view>
				<view v-for="nav in navItems" :key="nav.key" class="side-item" :class="{'side-item-on': view === nav.key}" @click="switchView(nav.key)">
					<text class="side-icon">{{nav.icon}}</text>
					<text class="side-label" :class="{'side-label-on': view === nav.key}">{{nav.label}}</text>
				</view>
			</view>
			<scroll-view class="main" scroll-y="true">
				<view class="content">

				<!-- 断连提示（后台轮询失败时显示，恢复后自动消失） -->
				<view v-if="netLost" class="net-lost"><text class="net-lost-text">网络不稳，正在自动重连…</text></view>

				<!-- ===== 管理首页 ===== -->
				<view v-if="view === 'home'">
					<view class="view-head">
						<text class="view-title">管理首页</text>
						<text class="view-sub">{{todayText()}} · 富记线上饭堂 · 每 30 秒自动刷新</text>
					</view>
					<view class="stat-row">
						<view class="stat-card">
							<text class="stat-num">{{todayOrderCount}}</text>
							<text class="stat-label">今日订单（单）</text>
						</view>
						<view class="stat-card stat-card-last">
							<text class="stat-num">¥{{fmt2(todayGmv)}}</text>
							<text class="stat-label">今日营业额</text>
						</view>
					</view>
					<button class="primary" @click="goTomorrowMenu">发布明日菜单</button>
					<text class="sec-title">快捷流程</text>
					<view class="quick-grid">
						<view class="quick-item" @click="switchView('menu')"><text class="quick-icon">🍚</text><text class="quick-label">菜单管理</text></view>
						<view class="quick-item" @click="switchView('orders')"><text class="quick-icon">📋</text><text class="quick-label">订单管理</text></view>
						<view class="quick-item" @click="switchView('delivery')"><text class="quick-icon">🛵</text><text class="quick-label">配送管理</text></view>
						<view class="quick-item" @click="switchView('data')"><text class="quick-icon">📊</text><text class="quick-label">数据统计</text></view>
					</view>
				</view>

				<!-- ===== 订单管理 ===== -->
				<view v-else-if="view === 'orders'">
					<view class="view-head">
						<text class="view-title">订单管理</text>
						<text class="view-sub">{{todayText()}} · 今日共 {{activeOrderCount}} 份订单</text>
					</view>
					<view class="chip-row">
						<view class="chip-f" :class="{'chip-f-on': orderFilter === 'all'}" @click="orderFilter = 'all'"><text class="chip-f-text" :class="{'chip-f-text-on': orderFilter === 'all'}">今日订单</text></view>
						<view class="chip-f" :class="{'chip-f-on': orderFilter === 'pending'}" @click="orderFilter = 'pending'"><text class="chip-f-text" :class="{'chip-f-text-on': orderFilter === 'pending'}">待备餐</text></view>
						<view class="chip-f" :class="{'chip-f-on': orderFilter === 'cooking'}" @click="orderFilter = 'cooking'"><text class="chip-f-text" :class="{'chip-f-text-on': orderFilter === 'cooking'}">备餐中</text></view>
						<view class="chip-f" :class="{'chip-f-on': orderFilter === 'ready'}" @click="orderFilter = 'ready'"><text class="chip-f-text" :class="{'chip-f-text-on': orderFilter === 'ready'}">待配送</text></view>
						<view class="chip-f" :class="{'chip-f-on': orderFilter === 'delivered'}" @click="orderFilter = 'delivered'"><text class="chip-f-text" :class="{'chip-f-text-on': orderFilter === 'delivered'}">已送达</text></view>
					</view>
					<view v-for="g in orderGroups" :key="g.loc" class="grp-card">
						<view class="grp-head" @click="toggleGroup(g.loc)">
							<view class="grp-locrow">
								<text class="grp-loc">{{g.loc}}</text>
								<text class="grp-badge">{{g.orders.length}} 单</text>
							</view>
							<view class="grp-right">
								<text class="grp-total">¥{{fmt2(g.total)}}</text>
								<text class="grp-toggle">{{expandedLoc === g.loc ? '收起' : '查看'}}</text>
							</view>
						</view>
						<view v-if="expandedLoc === g.loc" class="grp-body">
							<view v-for="o in g.orders" :key="o.no" class="grp-order" :class="{'order-cancel': o.status === 'canceled'}">
								<view class="go-row1">
									<text class="go-no">{{o.no}}</text>
									<text class="oc-meal" :class="o.meal === 'dinner' ? 'meal-dinner' : 'meal-lunch'">{{o.meal === 'dinner' ? '晚餐' : '午餐'}}</text>
									<text class="oc-status go-status" :class="statusClass(o.status)">{{statusText(o.status)}}</text>
									<view class="go-right">
										<text class="go-time">{{fmtTime(o.createdAt)}}</text>
										<text class="go-total">¥{{fmt2(o.total)}}</text>
									</view>
								</view>
								<text class="go-items">{{o.name !== '' ? o.name + ' · ' : ''}}{{itemsSummary(o)}}</text>
								<text v-if="o.note !== ''" class="oc-note">备注：{{o.note}}</text>
								<text v-if="lastLogText(o.no) !== ''" class="oc-logtime">最近状态：{{lastLogText(o.no)}}</text>
								<view v-if="o.status === 'pending' || o.status === 'cooking'" class="go-row2">
									<button class="act act-mini act-mini-main" :disabled="busyNo !== ''" @click="setStatus(o.no, o.status === 'pending' ? 'cooking' : 'ready')">{{o.status === 'pending' ? '开始备餐' : '出餐完成'}}</button>
									<button class="act act-mini act-mini-ghost" @click="printOrder(o)">打印</button>
									<button class="act act-mini act-mini-cancel" @click="cancelOrder(o.no)">取消</button>
								</view>
								<view v-else-if="o.status === 'ready'" class="go-row2">
									<text class="go-ready-tip">✓ 已出餐 · 待配送</text>
									<button class="act act-mini act-mini-ghost" @click="printOrder(o)">打印</button>
									<button class="act act-mini act-mini-cancel" @click="cancelOrder(o.no)">取消</button>
								</view>
								<view v-else-if="o.status === 'delivered'" class="go-row2">
									<button class="act act-mini act-mini-ghost" @click="printOrder(o)">打印</button>
								</view>
							</view>
						</view>
					</view>
					<view v-if="orderGroups.length === 0" class="empty-card"><text class="muted">当前筛选下没有订单</text></view>
				</view>

				<!-- ===== 配送管理 ===== -->
				<view v-else-if="view === 'delivery'">
					<view class="view-head">
						<text class="view-title">配送管理</text>
						<text class="view-sub">按取餐地点分组 · 两段式配送</text>
					</view>
					<view class="chip-row">
						<view class="chip-f" :class="{'chip-f-on': delivFilter === 'ready'}" @click="delivFilter = 'ready'"><text class="chip-f-text" :class="{'chip-f-text-on': delivFilter === 'ready'}">待配送</text></view>
						<view class="chip-f" :class="{'chip-f-on': delivFilter === 'delivering'}" @click="delivFilter = 'delivering'"><text class="chip-f-text" :class="{'chip-f-text-on': delivFilter === 'delivering'}">配送中</text></view>
						<view class="chip-f" :class="{'chip-f-on': delivFilter === 'done'}" @click="delivFilter = 'done'"><text class="chip-f-text" :class="{'chip-f-text-on': delivFilter === 'done'}">已完成</text></view>
					</view>
					<view v-for="g in delivGroups" :key="g.loc" class="deliv-card">
						<view class="deliv-info">
							<view class="deliv-locrow">
								<text class="deliv-loc">{{g.loc}}</text>
								<text class="deliv-badge" :class="g.state === 'done' ? 'deliv-badge-done' : (g.state === 'delivering' ? 'deliv-badge-doing' : 'deliv-badge-ready')">{{delivStateText(g.state)}}</text>
							</view>
							<text class="deliv-meta">{{delivMeta(g)}}</text>
						</view>
						<button v-if="g.state === 'ready'" class="act-deliver" :disabled="deliveringLoc !== ''" @click="startDeliver(g)">开始配送</button>
						<button v-else-if="g.state === 'delivering'" class="act-deliver act-deliver-done" :disabled="deliveringLoc !== ''" @click="finishDeliver(g)">{{deliveringLoc === g.loc ? '配送中…' : '完成配送'}}</button>
					</view>
					<view v-if="delivGroups.length === 0" class="empty-card"><text class="muted">当前筛选下没有配送任务</text></view>
				</view>

				<!-- ===== 数据统计 ===== -->
				<view v-else-if="view === 'data'">
					<view class="view-head">
						<text class="view-title">数据统计</text>
						<text class="view-sub">{{todayText()}}</text>
					</view>
					<view class="stat-row">
						<view class="stat-card"><text class="stat-num">{{todayOrderCount}}</text><text class="stat-label">今日订单（单）</text></view>
						<view class="stat-card"><text class="stat-num">¥{{fmt2(todayGmv)}}</text><text class="stat-label">今日营业额</text></view>
						<view class="stat-card stat-card-last"><text class="stat-num">¥{{fmt2(todayExtra)}}</text><text class="stat-label">加价收入</text></view>
					</view>
					<text class="sec-title">分餐次</text>
					<view v-for="meal in mealBlocks" :key="meal.key" class="meal-stat">
						<text class="meal-stat-title">{{meal.title}}</text>
						<view class="meal-stat-nums">
							<view class="meal-stat-item"><text class="ms-num">{{meal.orderCount}}</text><text class="ms-label">订单数</text></view>
							<view class="meal-stat-item"><text class="ms-num">¥{{fmt2(meal.gmv)}}</text><text class="ms-label">营业额</text></view>
						</view>
					</view>
					<text class="sec-title">热门菜品榜</text>
					<view class="hot-card">
						<view v-if="hotDishes.length === 0" class="hot-empty"><text class="muted">今天还没有菜品销量数据</text></view>
						<view v-for="(h, hi) in hotDishes" :key="h.name" class="hot-row">
							<text class="hot-rank" :class="hi < 3 ? 'hot-rank-top' : ''">{{hi + 1}}</text>
							<text class="hot-name">{{h.name}}</text>
							<text class="hot-qty">{{h.qty}} 份</text>
							<text class="hot-amount">¥{{fmt2(h.amount)}}</text>
						</view>
					</view>
				</view>

				<!-- ===== 设置 ===== -->
				<view v-else-if="view === 'settings'">
					<view class="view-head">
						<text class="view-title">设置</text>
						<text class="view-sub">蓝牙打印 · 连一次即可，以后打印自动重连</text>
					</view>
					<view class="bt-panel">
						<view class="bt-head">
							<text class="bt-title">蓝牙打印机</text>
							<view class="bt-close" @click="togglePrinterPanel"><text class="bt-close-text">{{showPrinter ? '收起面板' : '扫描连接'}}</text></view>
						</view>
						<text class="bt-status">状态：{{btStateText()}}</text>
						<view v-if="showPrinter">
							<button class="bt-scan" @click="startScan">{{btState === 'scanning' ? '搜索中… 点下面设备连接' : '搜索打印机'}}</button>
							<text v-if="btState === 'scanning'" class="bt-status">已发现 {{btDevs.length}} 台 · 已拉取 {{btTicks}} 次 · {{btEnv === 'devtools' ? 'devtools(模拟器)' : btEnv}}</text>
							<view v-for="(nm, index) in btDevs" :key="index" class="bt-dev" @click="pickDevice(index)">
								<text class="bt-dev-name">{{nm}}</text>
								<text class="bt-dev-conn">连接</text>
							</view>
							<text class="bt-tip">打印机先开机；搜不到就长按打印机走纸键进入配对模式再搜。连一次即可，以后打印自动重连。</text>
						</view>
					</view>
					<view class="about-card">
						<text class="about-title">关于</text>
						<text class="about-line">富记厨房端 · 仅限店内使用</text>
						<text class="about-line">当前日期：{{bjDateStrOf(Date.now())}}</text>
					</view>
				</view>

				<!-- ===== 菜单管理 ===== -->
				<view v-else>
					<view class="view-head-row">
						<text class="view-title">菜单管理</text>
						<button class="act-add" @click="addDish">＋ 新增菜品</button>
					</view>
					<view class="pill-row">
						<view class="pill" :class="{'pill-on': menuDateMode === 'today'}" @click="switchMenuDay('today')"><text class="pill-text" :class="{'pill-text-on': menuDateMode === 'today'}">今天</text></view>
						<view class="pill" :class="{'pill-on': menuDateMode === 'tomorrow'}" @click="switchMenuDay('tomorrow')"><text class="pill-text" :class="{'pill-text-on': menuDateMode === 'tomorrow'}">明天</text></view>
						<view class="pill" @click="useTemplate"><text class="pill-text">按模板重生成</text></view>
					</view>
					<text class="menu-date-hint">{{menuDate}} · 改完点「发布菜单」才生效</text>

					<view v-for="(dish, index) in menuDishes" :key="dish.id" class="dish-card" :class="{'dish-off': dish.soldOut}">
						<view class="dish-row" @click="toggleEdit(index)">
							<image class="dish-img" :src="dish.image" mode="aspectFill"></image>
							<view class="dish-info">
								<text class="dish-name">{{dish.name === '' ? '（未命名）' : dish.name}}</text>
								<view class="dish-meta">
									<text class="dc-cat">{{dish.category}}</text>
									<text class="dish-badge" :class="dish.soldOut ? 'dish-badge-off' : 'dish-badge-on'">{{dish.soldOut ? '已下架' : '上架中'}}</text>
								</view>
							</view>
							<view class="dish-right">
								<text class="dish-price">¥{{fmt2(dish.basePrice)}}{{dish.canCustomPrice ? ' 起' : ''}}</text>
								<text class="dish-edit">{{editIdx === index ? '收起' : '编辑'}}</text>
							</view>
						</view>
						<view class="dish-ops">
							<view class="dc-op" @click="toggleSoldOut(dish)"><text class="dc-op-text">{{dish.soldOut ? '恢复售卖' : '售罄'}}</text></view>
							<view class="dc-op" @click="removeDish(index)"><text class="dc-op-text dc-op-del">删除</text></view>
						</view>
						<view v-if="editIdx === index" class="edit-card">
							<text class="edit-title">编辑菜品</text>
							<view class="edit-row"><text class="edit-label">菜名</text><input class="edit-input" v-model="editName" placeholder="如：茄子肉末" placeholder-class="ph" /></view>
							<view class="edit-row"><text class="edit-label">价格</text><input class="edit-input" type="digit" v-model="editPrice" placeholder="如：6" placeholder-class="ph" /></view>
							<view class="edit-row"><text class="edit-label">分类</text><input class="edit-input" v-model="editCategory" placeholder="素菜 / 荤素搭配 / 纯荤" placeholder-class="ph" /></view>
							<view class="edit-row"><text class="edit-label">描述</text><input class="edit-input" v-model="editDesc" placeholder="如：微辣 · 可加价" placeholder-class="ph" /></view>
							<view class="edit-row">
								<text class="edit-label">配图</text>
								<image v-if="editImg !== ''" class="edit-img" :src="editImg" mode="aspectFill"></image>
								<view v-else class="edit-img edit-img-empty"><text class="edit-img-empty-t">暂无图</text></view>
								<button class="act act-gen" :disabled="genImgLoading" @click="genImage">{{genImgLoading ? '生成中，约 1~3 分钟…' : 'AI 生成配图'}}</button>
							</view>
							<view class="edit-chips">
								<view class="chip-t" :class="{'chip-t-on': editCustom}" @click="toggleEditCustom"><text class="chip-t-text" :class="{'chip-t-text-on': editCustom}">可加价</text></view>
							</view>
							<view class="edit-btns">
								<button class="act act-main" @click="saveEdit">保存该菜</button>
								<button class="act act-cancel" @click="closeEdit">取消</button>
							</view>
						</view>
					</view>
					<view v-if="menuDishes.length === 0" class="empty-card"><text class="muted">菜单是空的：点「＋ 新增菜品」手写，或点上方「按模板重生成」</text></view>

					<view class="pub-row">
						<view class="chip-t" :class="{'chip-t-on': menuSyncTpl}" @click="toggleSyncTpl"><text class="chip-t-text" :class="{'chip-t-text-on': menuSyncTpl}">同步为模板</text></view>
						<text class="pub-hint">模板 = 以后每天自动生成的默认菜单</text>
					</view>
					<button class="primary" :disabled="publishing" @click="publishMenu">{{publishing ? '发布中…' : '发布菜单'}}</button>
				</view>

					<view class="footer-space"></view>
				</view>
			</scroll-view>
		</view>
		<view v-if="toastMessage !== ''" class="toast">{{toastMessage}}</view>
	</view>
</template>

<script setup lang="uts">
import { requestJson, requestJsonTimeout } from '../../common/http.uts'
import { showPrinter, btState, btDevs, btTicks, btEnv, btStateText, startScan, pickDevice, printOrder, initPrinter, AdminOrder, AdminItem, fmt2, fmtTime, bjDateStrOf } from './bt-printer.uts'

	// 厨房管理端（小程序版）：走 cf-api 云函数（mod=admin）HTTP 直连，与点单页同源同模式。
	// 功能：今日订单（汇总 + 状态流转）· 菜单发布（编辑某日菜单，可同步模板）· 蓝牙热敏小票打印（58mm ESC/POS + GBK）
	type DishLine = { name: string; qty: number; amount: number }
	type MealBlock = { key: string; title: string; state: string; stateCls: string; lines: DishLine[]; orderCount: number; gmv: number; customExtra: number }
	type MenuDish = { id: string; category: string; name: string; desc: string; basePrice: number; canCustomPrice: boolean; image: string; soldOut: boolean }
	// 配送分组：state=ready待配送/delivering配送中/done已送达；readyNos=待配送单号
	type DelivGroup = { loc: string; state: string; readyNos: string[]; deliveringNos: string[]; doneCount: number; readyTotal: number; deliveringTotal: number; doneTotal: number }
	// 订单管理视图的地点分组
	type OrderGroup = { loc: string; orders: AdminOrder[]; total: number }
	// 热门菜品榜行（两餐 dishLines 合并）
	type HotDish = { name: string; qty: number; amount: number }


	const showGate = ref(false)
	const passInput = ref('')
	const gateErr = ref('')
	const checking = ref(false)
	var pass = ''

	const loading = ref(false)
	const sumDate = ref('')
	const mealBlocks = ref<MealBlock[]>([])
	const orders = ref<AdminOrder[]>([])
	const toastMessage = ref('')
	const busyNo = ref('')
	const netLost = ref(false) // 后台轮询断连标记：失败亮横条不弹窗，恢复后自动消失
	const deliveringLoc = ref('') // 正在批量改状态的地点（防重复触发）
	var orderLogs: Map<string, UTSJSONObject> = new Map() // 单号 → status_log（非响应式，随每次 summary 重建，渲染时 orders 变化会重新取）

	// ---------- 视图切换 ----------
	type NavItem = { key: string; icon: string; label: string }
	const navItems: NavItem[] = [
		{ key: 'home', icon: '🏠', label: '首页' },
		{ key: 'orders', icon: '📋', label: '订单' },
		{ key: 'menu', icon: '🍚', label: '菜单' },
		{ key: 'delivery', icon: '🛵', label: '配送' },
		{ key: 'data', icon: '📊', label: '数据' },
		{ key: 'settings', icon: '⚙️', label: '设置' }
	]
	const view = ref('home')
	const orderFilter = ref('all') // all | pending | cooking | ready | delivered
	const delivFilter = ref('ready') // ready | delivering | done
	const expandedLoc = ref('') // 订单管理里展开的地点（单开）
	// ---------- 菜单发布 ----------
	const menuDateMode = ref('today') // today | tomorrow
	const menuDate = ref('')
	const menuDishes = ref<MenuDish[]>([])
	const tplDishes = ref<MenuDish[]>([])
	const menuLoading = ref(false)
	const publishing = ref(false)
	const menuSyncTpl = ref(true)
	const editIdx = ref(-1)
	const editName = ref('')
	const editPrice = ref('')
	const editCategory = ref('')
	const editDesc = ref('')
	const editCustom = ref(false)
	const editImg = ref('')
	const genImgLoading = ref(false)
	var menuLoadedOnce = false


	function toast(msg: string) { toastMessage.value = msg; setTimeout(() => { toastMessage.value = '' }, 1800) }
initPrinter(toast)
	function statusText(s: string): string { if (s === 'cooking') return '制作中'; if (s === 'ready') return '待配送'; if (s === 'delivering') return '配送中'; if (s === 'delivered') return '已送达'; if (s === 'canceled') return '已取消'; return '待处理' }
	function statusClass(s: string): string { if (s === 'cooking') return 'st-cooking'; if (s === 'ready') return 'st-ready'; if (s === 'delivering') return 'st-cooking'; if (s === 'delivered') return 'st-delivered'; if (s === 'canceled') return 'st-cancel'; return 'st-pending' }

	function menuDateStr(): string {
		return menuDateMode.value === 'tomorrow' ? bjDateStrOf(Date.now() + 86400000) : bjDateStrOf(Date.now())
	}


	// 北京当前时刻（与 index 页 bjNow 同口径：平移到北京墙上钟后按 UTC 读）
	function bjNow(): Date {
		return new Date(Date.now() + (480 + new Date().getTimezoneOffset()) * 60000)
	}

	// 餐次状态：未截单=可点单；截单~出炉=制作中；出炉~收档=可取餐；收档后=已收档
	// 午餐 11:00/11:30/13:00，晚餐 16:00/17:30/19:30（北京时间）
	function mealStateOf(cutoffPassed: boolean, meal: string, bj: Date): string {
		const mins = bj.getUTCHours() * 60 + bj.getUTCMinutes()
		const dinner = meal === 'dinner'
		const cut = dinner ? 16 * 60 : 11 * 60
		const oven = dinner ? 17 * 60 + 30 : 11 * 60 + 30
		const close = dinner ? 19 * 60 + 30 : 13 * 60
		if (mins >= close) { return '已收档' }
		if (mins >= oven) { return '可取餐' }
		if (cutoffPassed || mins >= cut) { return '制作中' }
		return '可点单'
	}

	function mealStateClass(state: string): string {
		if (state === '制作中') { return 'badge-cut' }
		if (state === '可取餐') { return 'badge-ready' }
		if (state === '已收档') { return 'badge-closed' }
		return 'badge-live'
	}

	function parseMealBlock(meals: UTSJSONObject, key: string, title: string, bj: Date): MealBlock {
		const lines: DishLine[] = []
		let gmv = 0
		let extra = 0
		let count = 0
		let cutoff = false
		const meal = meals.getJSON(key)
		if (meal instanceof UTSJSONObject) {
			cutoff = meal.getBoolean('cutoffPassed') === true
			gmv = meal.getNumber('totalGmv') ?? 0
			extra = meal.getNumber('customExtra') ?? 0
			count = Math.floor(meal.getNumber('orderCount') ?? 0)
			const arr = meal.getArray('dishLines')
			if (arr !== null) {
				for (let i = 0; i < arr.length; i++) {
					const o = arr[i]
					if (o instanceof UTSJSONObject) {
						lines.push({ name: o.getString('name') ?? '', qty: Math.floor(o.getNumber('qty') ?? 0), amount: o.getNumber('amount') ?? 0 })
					}
				}
			}
		}
		const state = mealStateOf(cutoff, key, bj)
		return { key: key, title: title, state: state, stateCls: mealStateClass(state), lines: lines, orderCount: count, gmv: gmv, customExtra: extra }
	}

	function applySummary(result: UTSJSONObject) {
		const data = result.getJSON('data')
		if (!(data instanceof UTSJSONObject)) { toast('数据格式异常'); return }
		const meals = data.getJSON('meals')
		if (!(meals instanceof UTSJSONObject)) { toast('数据格式异常'); return }
		sumDate.value = data.getString('date') ?? ''
		const bj = bjNow()
		const blocks: MealBlock[] = []
		blocks.push(parseMealBlock(meals, 'lunch', '午餐', bj))
		blocks.push(parseMealBlock(meals, 'dinner', '晚餐', bj))
		const list: AdminOrder[] = []
		const logs: Map<string, UTSJSONObject> = new Map()
		const arr2 = data.getArray('orders')
		if (arr2 !== null) {
			for (let i = 0; i < arr2.length; i++) {
				const o = arr2[i]
				if (o instanceof UTSJSONObject) {
					const cust = o.getJSON('customer')
					let name = ''; let location = ''; let phone = ''; let note = ''
					if (cust instanceof UTSJSONObject) {
						name = cust.getString('name') ?? ''
						location = cust.getString('location') ?? ''
						phone = cust.getString('phone') ?? ''
						note = cust.getString('note') ?? ''
					}
					const items: AdminItem[] = []
					const itemsArr = o.getArray('items')
					if (itemsArr !== null) {
						for (let j = 0; j < itemsArr.length; j++) {
							const it = itemsArr[j]
							if (it instanceof UTSJSONObject) {
								items.push({ name: it.getString('name') ?? '', pay: it.getNumber('pay') ?? 0, qty: Math.floor(it.getNumber('qty') ?? 0) })
							}
						}
					}
					let meal = o.getString('meal') ?? 'lunch' // 老订单可能没有 meal 字段，按午餐处理
					if (meal !== 'dinner') { meal = 'lunch' }
					const no = o.getString('orderNo') ?? ''
					const slog = o.getJSON('status_log') // 云端 updateStatus 写入的各状态达成时间戳
					if (slog instanceof UTSJSONObject) { logs.set(no, slog) }
					list.push({ no: no, meal: meal, status: o.getString('status') ?? '', total: o.getNumber('total') ?? 0, name: name, location: location, phone: phone, note: note, items: items, createdAt: o.getNumber('createdAt') ?? 0 })
				}
			}
		}
		orders.value = list
		orderLogs = logs
		// 餐次内有效订单全部已送达时，状态 chip 显示「已送达」
		for (let i = 0; i < blocks.length; i++) {
			const b = blocks[i]
			let active = 0
			let doneCnt = 0
			for (let j = 0; j < list.length; j++) {
				const o2 = list[j]
				if (o2.meal !== b.key || o2.status === 'canceled') { continue }
				active++
				if (o2.status === 'delivered') { doneCnt++ }
			}
			if (active > 0 && doneCnt === active) { b.state = '已送达'; b.stateCls = 'badge-delivered' }
		}
		mealBlocks.value = blocks
	}

	async function loadSummary() {
		if (pass === '') { showGate.value = true; return }
		loading.value = true
		const result = await requestJson('/cf-admin', { password: pass, action: 'summary', date: '' } as UTSJSONObject)
		loading.value = false
		if (result !== null && result.getBoolean('ok') === true) {
			applySummary(result)
		} else {
			const err = result !== null ? (result.getString('err') ?? '') : ''
			if (err.indexOf('口令') >= 0) { pass = ''; uni.removeStorageSync('xk_admin_pass'); showGate.value = true; gateErr.value = '口令已失效，请重新输入' }
			else { toast(result !== null ? (err === '' ? '加载失败，请重试' : err) : '网络异常，请重试') }
		}
	}

	// 静默轮询（后台自动刷新专用）：失败不弹 toast、不闪 loading，只亮断连横条；
	// 口令失效除外——那种情况要把输入门弹回来
	async function pollSummary() {
		if (showGate.value || pass === '') return
		const result = await requestJson('/cf-admin', { password: pass, action: 'summary', date: '' } as UTSJSONObject)
		if (result !== null && result.getBoolean('ok') === true) {
			netLost.value = false
			applySummary(result)
			return
		}
		const err = result !== null ? (result.getString('err') ?? '') : ''
		if (err.indexOf('口令') >= 0) {
			netLost.value = false
			pass = ''
			uni.removeStorageSync('xk_admin_pass')
			showGate.value = true
			gateErr.value = '口令已失效，请重新输入'
		} else {
			netLost.value = true
		}
	}

	async function submitGate() {
		if (checking.value) return
		const p = passInput.value.trim()
		if (p === '') { gateErr.value = '请输入口令'; return }
		checking.value = true
		const result = await requestJson('/cf-admin', { password: p, action: 'summary', date: '' } as UTSJSONObject)
		checking.value = false
		if (result !== null && result.getBoolean('ok') === true) {
			pass = p
			uni.setStorageSync('xk_admin_pass', p)
			showGate.value = false
			gateErr.value = ''
			applySummary(result)
		} else {
			gateErr.value = result !== null ? (result.getString('err') ?? '口令错误') : '网络异常，请重试'
		}
	}

	async function setStatus(no: string, status: string) {
		if (busyNo.value !== '') return
		busyNo.value = no
		const result = await requestJson('/cf-admin', { password: pass, action: 'updateStatus', orderNo: no, status: status } as UTSJSONObject)
		busyNo.value = ''
		if (result !== null && result.getBoolean('ok') === true) {
			toast(status === 'canceled' ? '已取消' : '状态已更新')
			loadSummary()
		} else {
			toast(result !== null ? (result.getString('err') ?? '操作失败') : '网络异常，请重试')
		}
	}

	function cancelOrder(no: string) {
		uni.showModal({
			title: '取消订单',
			content: '确定取消 ' + no + ' 吗？取消后不计入今日汇总。',
			success: (res) => { if (res.confirm === true) { setStatus(no, 'canceled') } }
		})
	}

	// ---------- 状态时间辅助（订单行最后状态时间） ----------
	function pad2(n: number): string { return n < 10 ? '0' + n : '' + n }

	// 北京时间 MM-DD HH:mm（与 bjDateStrOf 同口径：平移到北京墙上钟后按 UTC 读）
	function fmtBjMDHM(ms: number): string {
		const d = new Date(ms + (480 + new Date(ms).getTimezoneOffset()) * 60000)
		return pad2(d.getUTCMonth() + 1) + '-' + pad2(d.getUTCDate()) + ' ' + pad2(d.getUTCHours()) + ':' + pad2(d.getUTCMinutes())
	}

	// 订单卡上的最后状态时间：取 status_log 里时间戳最大的状态
	function lastLogText(no: string): string {
		const log = orderLogs.get(no)
		if (!(log instanceof UTSJSONObject)) { return '' }
		const keys: string[] = ['pending', 'cooking', 'ready', 'delivered', 'canceled']
		const names: string[] = ['下单', '制作', '出餐', '送达', '取消']
		let best = 0
		let label = ''
		for (let i = 0; i < keys.length; i++) {
			const t = log.getNumber(keys[i]) ?? 0
			if (t > best) { best = t; label = names[i] }
		}
		if (best <= 0) { return '' }
		return label + ' ' + fmtBjMDHM(best)
	}

	// ---------- 配送管理 ----------

	// ready/delivered 订单按 customer.location 分组（空归「未填地点」），按配送中→待配送→已送达排序，并按筛选过滤
	const delivGroups = computed((): DelivGroup[] => {
		const list = orders.value
		const grouped: DelivGroup[] = []
		const locs: string[] = []
		for (let i = 0; i < list.length; i++) {
			const o = list[i]
			if (o.status !== 'ready' && o.status !== 'delivering' && o.status !== 'delivered') { continue }
			const loc = o.location.trim() === '' ? '未填地点' : o.location.trim()
			let idx = locs.indexOf(loc)
			if (idx < 0) {
				locs.push(loc)
				const ng: DelivGroup = { loc: loc, state: 'ready', readyNos: [], deliveringNos: [], doneCount: 0, readyTotal: 0, deliveringTotal: 0, doneTotal: 0 }
				grouped.push(ng)
				idx = grouped.length - 1
			}
			const g = grouped[idx]
			if (o.status === 'ready') { g.readyNos.push(o.no); g.readyTotal += o.total }
			else if (o.status === 'delivering') { g.deliveringNos.push(o.no); g.deliveringTotal += o.total }
			else { g.doneCount += 1; g.doneTotal += o.total }
		}
		for (let i = 0; i < grouped.length; i++) {
			const g = grouped[i]
			if (g.deliveringNos.length > 0) { g.state = 'delivering' }
			else if (g.readyNos.length === 0) { g.state = 'done' }
			else { g.state = 'ready' }
		}
		const out: DelivGroup[] = []
		const rank: string[] = ['delivering', 'ready', 'done']
		for (let r = 0; r < rank.length; r++) {
			for (let i = 0; i < grouped.length; i++) {
				if (grouped[i].state === rank[r] && grouped[i].state === delivFilter.value) { out.push(grouped[i]) }
			}
		}
		return out
	})

	function delivStateText(state: string): string { if (state === 'delivering') return '配送中'; if (state === 'done') return '已送达'; return '待配送' }

	function delivMeta(g: DelivGroup): string {
		const total = g.readyTotal + g.deliveringTotal + g.doneTotal
		const parts: string[] = []
		if (g.doneCount > 0) { parts.push('已送达 ' + g.doneCount) }
		if (g.deliveringNos.length > 0) { parts.push('配送中 ' + g.deliveringNos.length) }
		if (g.readyNos.length > 0) { parts.push('待配送 ' + g.readyNos.length) }
		if (parts.length === 0) { parts.push('0 单') }
		return parts.join(' · ') + ' · 共 ¥' + fmt2(total)
	}

	// 开始配送：把该组待配送订单批量标记为 delivering（云端状态机持久化，全端一致）
	function startDeliver(g: DelivGroup) {
		if (deliveringLoc.value !== '') return
		if (g.readyNos.length === 0) { toast('该地点没有待配送订单'); return }
		doBatchStatus(g.loc, g.readyNos, 'delivering', '开始配送')
	}

	// 完成配送：把该组配送中订单批量标记为已送达
	function finishDeliver(g: DelivGroup) {
		if (deliveringLoc.value !== '') return
		if (g.deliveringNos.length === 0) { toast('该地点没有配送中的订单'); return }
		uni.showModal({
			title: '完成配送',
			content: '把「' + g.loc + '」的 ' + g.deliveringNos.length + ' 单标记为已送达？',
			success: (res) => { if (res.confirm === true) { doBatchStatus(g.loc, g.deliveringNos, 'delivered', '完成配送') } }
		})
	}

	// 逐单调 updateStatus，结束后刷新汇总（部分失败也刷新，成功的先生效）
	async function doBatchStatus(loc: string, nos: string[], status: string, actionLabel: string) {
		deliveringLoc.value = loc
		let okCount = 0
		for (let i = 0; i < nos.length; i++) {
			const result = await requestJson('/cf-admin', { password: pass, action: 'updateStatus', orderNo: nos[i], status: status } as UTSJSONObject)
			if (result !== null && result.getBoolean('ok') === true) { okCount++ }
		}
		deliveringLoc.value = ''
		if (okCount === nos.length) { toast('「' + loc + '」' + okCount + ' 单已' + actionLabel) }
		else { toast(actionLabel + ' ' + okCount + '/' + nos.length + ' 单，未成功的可重试') }
		loadSummary()
	}

	// ---------- 数据统计 ----------
	const todayOrderCount = computed((): number => { let n = 0; for (let i = 0; i < mealBlocks.value.length; i++) { n += mealBlocks.value[i].orderCount } return n })
	const todayGmv = computed((): number => { let g = 0; for (let i = 0; i < mealBlocks.value.length; i++) { g += mealBlocks.value[i].gmv } return g })
	const todayExtra = computed((): number => { let e = 0; for (let i = 0; i < mealBlocks.value.length; i++) { e += mealBlocks.value[i].customExtra } return e })
	const activeOrderCount = computed((): number => { let n = 0; for (let i = 0; i < orders.value.length; i++) { if (orders.value[i].status !== 'canceled') { n++ } } return n })

	// 热门菜品榜：两餐 dishLines 合并按份数降序取前 8（选择排序，菜量小无需 sort）
	const hotDishes = computed((): HotDish[] => {
		const names: string[] = []
		const qtys: number[] = []
		const amts: number[] = []
		for (let i = 0; i < mealBlocks.value.length; i++) {
			const lines = mealBlocks.value[i].lines
			for (let j = 0; j < lines.length; j++) {
				const l = lines[j]
				let idx = names.indexOf(l.name)
				if (idx < 0) { names.push(l.name); qtys.push(0); amts.push(0); idx = names.length - 1 }
				qtys[idx] += l.qty
				amts[idx] += l.amount
			}
		}
		const pool: HotDish[] = []
		for (let i = 0; i < names.length; i++) { pool.push({ name: names[i], qty: qtys[i], amount: amts[i] }) }
		const out: HotDish[] = []
		while (out.length < 8 && pool.length > 0) {
			let mi = 0
			for (let i = 1; i < pool.length; i++) { if (pool[i].qty > pool[mi].qty) { mi = i } }
			out.push(pool[mi])
			pool.splice(mi, 1)
		}
		return out
	})

	// ---------- 订单管理：按配送地点分组（筛选后分组，canceled 仅在「今日订单」下显示且不计金额） ----------
	const orderGroups = computed((): OrderGroup[] => {
		const f = orderFilter.value
		const list = orders.value
		const out: OrderGroup[] = []
		const locs: string[] = []
		for (let i = 0; i < list.length; i++) {
			const o = list[i]
			if (f !== 'all' && o.status !== f) { continue }
			const loc = o.location.trim() === '' ? '未填地点' : o.location.trim()
			let idx = locs.indexOf(loc)
			if (idx < 0) {
				locs.push(loc)
				const ng: OrderGroup = { loc: loc, orders: [], total: 0 }
				out.push(ng)
				idx = out.length - 1
			}
			const g = out[idx]
			g.orders.push(o)
			if (o.status !== 'canceled') { g.total += o.total }
		}
		return out
	})

	// ================= 菜单发布 =================

	function switchView(t: string) {
		view.value = t
		if (t === 'menu' && !menuLoadedOnce) { menuLoadedOnce = true; loadMenu() }
	}

	// 首页「发布明日菜单」：切到菜单管理并定位到明天
	function goTomorrowMenu() {
		menuDateMode.value = 'tomorrow'
		if (menuLoadedOnce) { loadMenu() }
		switchView('menu')
	}

	function todayText(): string { return sumDate.value !== '' ? sumDate.value : bjDateStrOf(Date.now()) }

	function toggleGroup(loc: string) { expandedLoc.value = expandedLoc.value === loc ? '' : loc }

	function toggleEdit(index: number) { if (editIdx.value === index) { editIdx.value = -1 } else { openEdit(index) } }

	// 订单明细摘要：菜名×份数用顿号连接
	function itemsSummary(o: AdminOrder): string {
		let s = ''
		for (let i = 0; i < o.items.length; i++) { const it = o.items[i]; s += (i > 0 ? '、' : '') + it.name + '×' + it.qty }
		return s === '' ? '无明细' : s
	}

	function switchMenuDay(mode: string) {
		if (menuDateMode.value === mode) return
		menuDateMode.value = mode
		if (menuLoadedOnce) { loadMenu() }
	}

	async function loadMenu() {
		if (pass === '') { showGate.value = true; return }
		if (menuLoading.value) return
		menuLoading.value = true
		const result = await requestJson('/cf-admin', { password: pass, action: 'getMenu', date: menuDateStr() } as UTSJSONObject)
		menuLoading.value = false
		if (result !== null && result.getBoolean('ok') === true) {
			applyMenu(result)
		} else {
			toast(result !== null ? (result.getString('err') ?? '菜单加载失败') : '网络异常，请重试')
		}
	}

	function applyMenu(result: UTSJSONObject) {
		const data = result.getJSON('data')
		if (!(data instanceof UTSJSONObject)) { toast('数据格式异常'); return }
		menuDate.value = data.getString('date') ?? ''
		const list: MenuDish[] = []
		const arr = data.getArray('dishes')
		if (arr !== null) {
			for (let i = 0; i < arr.length; i++) {
				const o = arr[i]
				if (o instanceof UTSJSONObject) {
					list.push({
						id: o.getString('id') ?? '',
						category: o.getString('category') ?? '荤素搭配',
						name: o.getString('name') ?? '',
						desc: o.getString('desc') ?? '',
						basePrice: o.getNumber('basePrice') ?? 0,
						canCustomPrice: o.getBoolean('canCustomPrice') === true,
						image: o.getString('image') ?? '',
						soldOut: o.getBoolean('soldOut') === true
					})
				}
			}
		}
		const tlist: MenuDish[] = []
		const tarr = data.getArray('templates')
		if (tarr !== null) {
			for (let i = 0; i < tarr.length; i++) {
				const o = tarr[i]
				if (o instanceof UTSJSONObject) {
					tlist.push({
						id: o.getString('id') ?? '',
						category: o.getString('category') ?? '荤素搭配',
						name: o.getString('name') ?? '',
						desc: o.getString('desc') ?? '',
						basePrice: o.getNumber('basePrice') ?? 0,
						canCustomPrice: o.getBoolean('canCustomPrice') === true,
						image: o.getString('image') ?? '',
						soldOut: o.getBoolean('soldOut') === true
					})
				}
			}
		}
		tplDishes.value = tlist
		menuDishes.value = list
		editIdx.value = -1
		if (list.length === 0 && tlist.length > 0) {
			fillFromTemplate()
			toast('该日菜单还没发布，已按模板生成草稿')
		}
	}

	function fillFromTemplate() {
		const list: MenuDish[] = []
		for (let i = 0; i < tplDishes.value.length; i++) {
			const t = tplDishes.value[i]
			list.push({ id: t.id, category: t.category, name: t.name, desc: t.desc, basePrice: t.basePrice, canCustomPrice: t.canCustomPrice, image: t.image, soldOut: t.soldOut })
		}
		menuDishes.value = list
		editIdx.value = -1
	}

	function useTemplate() {
		if (tplDishes.value.length === 0) { toast('还没有模板：先去点单端打开一次小程序即可生成'); return }
		if (menuDishes.value.length > 0) {
			uni.showModal({
				title: '按模板重新生成',
				content: '会覆盖当前未发布的草稿，确定吗？',
				success: (res) => { if (res.confirm === true) { fillFromTemplate() } }
			})
		} else {
			fillFromTemplate()
		}
	}

	function openEdit(index: number) {
		if (index < 0 || index >= menuDishes.value.length) return
		const d = menuDishes.value[index]
		editIdx.value = index
		editName.value = d.name
		editPrice.value = fmt2(d.basePrice)
		editCategory.value = d.category
		editDesc.value = d.desc
		editCustom.value = d.canCustomPrice
		editImg.value = d.image
	}

	function addDish() {
		const d: MenuDish = {
			id: 'n' + Math.floor(Math.random() * 100000000),
			category: '荤素搭配', name: '', desc: '',
			basePrice: 6, canCustomPrice: true,
			image: '/static/dishes/mix1.png', soldOut: false
		}
		menuDishes.value.push(d)
		openEdit(menuDishes.value.length - 1)
	}

	function removeDish(index: number) {
		if (index < 0 || index >= menuDishes.value.length) return
		const d = menuDishes.value[index]
		uni.showModal({
			title: '删除菜品',
			content: '从草稿里删除「' + (d.name === '' ? '未命名' : d.name) + '」？点「发布菜单」后才真正生效。',
			success: (res) => {
				if (res.confirm === true) {
					menuDishes.value.splice(index, 1)
					if (editIdx.value === index) { editIdx.value = -1 }
				}
			}
		})
	}

	function toggleSoldOut(d: MenuDish) { d.soldOut = !d.soldOut }
	function toggleEditCustom() { editCustom.value = !editCustom.value }

	// AI 生成菜品配图：调 cf-api 的 genDishImage（生图 30~60 秒，走长超时）
	async function genImage() {
		if (genImgLoading.value) return
		if (editIdx.value < 0) return
		if (editName.value.trim() === '') { toast('先填菜名，再生成配图'); return }
		genImgLoading.value = true
		const result = await requestJsonTimeout('/cf-admin', { password: pass, action: 'genDishImage', name: editName.value.trim(), category: editCategory.value, desc: editDesc.value } as UTSJSONObject, 330000)
		genImgLoading.value = false
		if (editIdx.value < 0) return
		if (result !== null && result.getBoolean('ok') === true) {
			const data = result.getJSON('data')
			if (data instanceof UTSJSONObject) {
				editImg.value = data.getString('url') ?? ''
				toast('配图已生成 ✓ 记得保存该菜')
			} else { toast('生成失败，请重试') }
		} else {
			toast(result !== null ? (result.getString('err') ?? '生成失败，请重试') : '网络超时，请重试')
		}
	}
	function toggleSyncTpl() { menuSyncTpl.value = !menuSyncTpl.value }
	function togglePrinterPanel() { showPrinter.value = !showPrinter.value }
	function closeEdit() { editIdx.value = -1 }

	function saveEdit() {
		const idx = editIdx.value
		if (idx < 0 || idx >= menuDishes.value.length) { editIdx.value = -1; return }
		const name = editName.value.trim()
		if (name === '') { toast('菜名不能为空'); return }
		const p = parseFloat(editPrice.value)
		if (!(p >= 0) || p > 9999) { toast('价格不合法'); return }
		const d = menuDishes.value[idx]
		d.name = name
		d.basePrice = Math.round(p * 100) / 100
		d.category = editCategory.value.trim() === '' ? '荤素搭配' : editCategory.value.trim()
		d.desc = editDesc.value.trim()
		d.canCustomPrice = editCustom.value
		d.image = editImg.value.trim() === '' ? '/static/dishes/mix1.png' : editImg.value.trim()
		editIdx.value = -1
		toast('已保存修改，记得点「发布菜单」')
	}

	function publishMenu() {
		if (publishing.value) return
		if (menuDishes.value.length === 0) { toast('菜单是空的'); return }
		for (let i = 0; i < menuDishes.value.length; i++) {
			const d = menuDishes.value[i]
			if (d.name.trim() === '') { toast('第 ' + (i + 1) + ' 个菜品还没填菜名'); return }
			if (!(d.basePrice >= 0)) { toast('菜品「' + d.name + '」价格不对'); return }
		}
		uni.showModal({
			title: '发布菜单',
			content: '发布 ' + menuDate.value + ' 的菜单（' + menuDishes.value.length + ' 道菜）？发布后点单页立即生效。',
			success: (res) => { if (res.confirm === true) { doPublish() } }
		})
	}

	async function doPublish() {
		publishing.value = true
		const arr: Array<UTSJSONObject> = []
		for (let i = 0; i < menuDishes.value.length; i++) {
			const d = menuDishes.value[i]
			arr.push({
				id: d.id, category: d.category, name: d.name.trim(), desc: d.desc,
				basePrice: d.basePrice, canCustomPrice: d.canCustomPrice,
				image: d.image, soldOut: d.soldOut
			} as UTSJSONObject)
		}
		const result = await requestJson('/cf-admin', { password: pass, action: 'saveMenu', date: menuDate.value, dishes: arr, syncTemplate: menuSyncTpl.value } as UTSJSONObject)
		publishing.value = false
		if (result !== null && result.getBoolean('ok') === true) {
			toast('菜单已发布 ✓')
			loadMenu()
		} else {
			toast(result !== null ? (result.getString('err') ?? '发布失败，请重试') : '网络异常，请重试')
		}
	}

	// 启动：本机存过口令直接进面板，否则开口令门
	const saved = uni.getStorageSync('xk_admin_pass')
	if (saved instanceof String || typeof saved === 'string') { pass = saved as string }
	if (pass === '') { showGate.value = true } else { loadSummary() }

	// 注意：小程序端 uni-app x 运行时（vendor.js 的 initUni/promisify）会把 uni.onXxx(裸回调)
	// 转成 Promise 调用，我们的回调根本不会注册进 wx——实测设备事件永远收不到。
	// 因此设备发现完全依赖 pollBtDevices 的 getBluetoothDevices 轮询（对象式回调，已验证可用）；
	// 断连由 writeBLECharacteristicValue 的 fail 分支重置 btReady，不再注册 onBLEConnectionStateChange。

	// 后台自动刷新：正常 30 秒一轮；断连时 12 秒快速重试，恢复后自动回到 30 秒。
	// 轮询全部走 pollSummary（静默），手动刷新按钮仍走 loadSummary（保留 toast）
	var autoTimer = -1
	function schedulePoll() {
		autoTimer = setTimeout(() => { pollSummary(); schedulePoll() }, netLost.value ? 12000 : 30000)
	}
	schedulePoll()
	onUnmounted(() => { if (autoTimer !== -1) { clearTimeout(autoTimer) } })
</script>

<style>
	.page { flex: 1; background-color: #F6F3EB; color: #22301F; }
	.net-lost { margin: 12rpx 24rpx 0; padding: 12rpx 20rpx; background-color: #1D4226; border-radius: 12rpx; }
	.net-lost-text { font-size: 24rpx; color: #F6F3EB; }
	.shell { flex: 1; flex-direction: row; }
	.main { flex: 1; }
	.content { padding: 18px 14px 36px; }
	.muted { color: #8C9689; font-size: 12px; }
	/* ---------- 口令门 ---------- */
	.gate { flex: 1; display: flex; align-items: center; justify-content: center; padding: 0 28px; }
	.gate-card { width: 100%; background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 16px; padding: 28px 20px; display: flex; flex-direction: column; align-items: center; box-shadow: 0 10px 22px rgba(34,48,31,.08); }
	.seal { width: 46px; height: 46px; border-radius: 10px; background-color: #2F6B3F; display: flex; align-items: center; justify-content: center; transform: rotate(4deg); box-shadow: 0 6px 14px rgba(47,107,63,.35); }
	.seal-char { color: #FFFFFF; font-family: serif; font-size: 24px; font-weight: 900; }
	.gate-title { display: block; font-family: serif; font-size: 21px; font-weight: 900; letter-spacing: .12em; margin-top: 12px; color: #22301F; }
	.gate-sub { display: block; color: #8C9689; font-size: 11.5px; margin-top: 6px; }
	.gate-input { width: 100%; height: 46px; box-sizing: border-box; padding: 0 12px; background-color: #F3F7F1; border: 1px solid #E7E3D6; border-radius: 11px; font-size: 15px; margin-top: 18px; text-align: center; color: #22301F; }
	.ph { color: #8C9689; }
	.gate-err { color: #24522F; font-size: 12px; font-weight: 600; margin-top: 10px; }
	/* ---------- 通用按钮 ---------- */
	.primary { width: 100%; height: 46px; background-color: #2F6B3F; background-image: linear-gradient(180deg, #2F6B3F, #24522F 55%, #1D4226); color: #FFFFFF; border: 0; border-radius: 13px; font-size: 15px; font-weight: 700; letter-spacing: .12em; margin-top: 16px; box-shadow: 0 8px 18px rgba(47,107,63,.3); }
	/* ---------- 侧边栏 ---------- */
	.side { width: 66px; background-color: #1D4226; display: flex; flex-direction: column; align-items: center; padding-top: 16px; }
	.side-logo { width: 40px; height: 40px; border-radius: 12px; background-color: #2F6B3F; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
	.side-logo-char { color: #F6F3EB; font-family: serif; font-size: 20px; font-weight: 900; }
	.side-item { width: 54px; border-radius: 10px; padding: 8px 0; margin-bottom: 4px; display: flex; flex-direction: column; align-items: center; border-left-width: 3px; border-left-style: solid; border-left-color: rgba(0,0,0,0); }
	.side-item-on { background-color: rgba(255,255,255,.12); border-left-color: #FFFFFF; }
	.side-icon { font-size: 16px; }
	.side-label { font-size: 10px; color: rgba(246,243,235,.75); margin-top: 3px; }
	.side-label-on { color: #FFFFFF; font-weight: 700; }
	/* ---------- 视图外壳 ---------- */
	.view-head { margin-bottom: 14px; }
	.view-head-row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
	.view-title { display: block; font-family: serif; font-size: 22px; font-weight: 900; letter-spacing: .06em; color: #22301F; }
	.view-sub { display: block; font-family: monospace; font-size: 11px; color: #8C9689; margin-top: 4px; }
	/* ---------- 统计卡 ---------- */
	.stat-row { display: flex; flex-direction: row; margin-bottom: 12px; }
	.stat-card { flex: 1; background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 14px; padding: 14px 8px; margin-right: 10px; display: flex; flex-direction: column; align-items: center; box-shadow: 0 4px 10px rgba(34,48,31,.04); }
	.stat-card-last { margin-right: 0; }
	.stat-num { font-family: monospace; font-size: 21px; font-weight: 900; color: #2F6B3F; }
	.stat-label { font-size: 11px; color: #8C9689; margin-top: 6px; }
	/* ---------- 快捷流程 ---------- */
	.quick-grid { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
	.quick-item { width: 49%; background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 14px; padding: 16px 0; margin-bottom: 10px; display: flex; flex-direction: column; align-items: center; box-shadow: 0 4px 10px rgba(34,48,31,.04); }
	.quick-icon { font-size: 22px; }
	.quick-label { font-size: 12.5px; font-weight: 700; color: #22301F; margin-top: 6px; }
	/* ---------- 筛选 chips ---------- */
	.chip-row { display: flex; flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
	.chip-f { padding: 6px 12px; border-radius: 999px; background-color: #FFFFFF; border: 1px solid #E7E3D6; margin-right: 8px; margin-bottom: 8px; }
	.chip-f-on { background-color: #2F6B3F; border-color: #2F6B3F; }
	.chip-f-text { font-size: 12px; color: #24522F; font-weight: 600; }
	.chip-f-text-on { color: #FFFFFF; }
	/* ---------- 蓝牙面板 ---------- */
	.bt-panel { background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 16px; padding: 14px; margin-top: 14px; box-shadow: 0 6px 14px rgba(34,48,31,.05); }
	.bt-head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
	.bt-title { font-size: 15px; font-weight: 800; color: #22301F; }
	.bt-close { padding: 4px 10px; border: 1px solid #E7E3D6; border-radius: 999px; }
	.bt-close-text { font-size: 12px; color: #8C9689; }
	.bt-status { display: block; font-family: monospace; font-size: 12px; color: #24522F; margin-top: 8px; }
	.bt-scan { width: 100%; height: 40px; border-radius: 11px; background-color: #24522F; color: #E9F1E7; font-size: 13.5px; font-weight: 700; border: 0; line-height: 40px; padding: 0; margin: 10px 0 0 0; }
	.bt-dev { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 2px; border-bottom: 1px dashed #E7E3D6; }
	.bt-dev-name { font-size: 14px; font-weight: 600; color: #22301F; }
	.bt-dev-conn { font-size: 12px; color: #2F6B3F; font-weight: 700; }
	.bt-tip { display: block; font-size: 11.5px; color: #8C9689; margin-top: 8px; }
	/* ---------- 地点分组卡 ---------- */
	.grp-card { background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 14px; padding: 12px 14px; margin-bottom: 10px; box-shadow: 0 4px 10px rgba(34,48,31,.04); }
	.grp-head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
	.grp-locrow { display: flex; flex-direction: row; align-items: center; }
	.grp-loc { font-size: 15px; font-weight: 800; color: #22301F; }
	.grp-badge { background-color: #E9F1E7; color: #2F6B3F; border-radius: 7px; padding: 2px 8px; font-size: 11px; font-weight: 700; margin-left: 8px; }
	.grp-right { display: flex; flex-direction: row; align-items: center; }
	.grp-total { font-family: monospace; font-size: 15px; font-weight: 800; color: #2F6B3F; margin-right: 10px; }
	.grp-toggle { font-size: 11.5px; color: #8C9689; font-weight: 600; border: 1px solid #E7E3D6; border-radius: 999px; padding: 4px 10px; }
	.grp-body { margin-top: 10px; border-top: 1px dashed #E7E3D6; }
	.grp-order { padding: 10px 0; border-bottom: 1px dashed #E7E3D6; }
	.go-row1 { display: flex; flex-direction: row; align-items: center; }
	.go-no { font-family: monospace; font-size: 12.5px; font-weight: 800; letter-spacing: .02em; color: #22301F; }
	.go-status { margin-left: 8px; }
	.go-right { display: flex; flex-direction: column; align-items: flex-end; margin-left: auto; }
	.go-time { font-family: monospace; font-size: 10.5px; color: #8C9689; }
	.go-total { font-family: monospace; font-size: 14px; font-weight: 800; color: #2F6B3F; margin-top: 2px; }
	.go-items { display: block; font-size: 12.5px; color: #22301F; margin-top: 6px; }
	.go-row2 { display: flex; flex-direction: row; align-items: center; margin-top: 8px; }
	.go-ready-tip { flex: 1; font-size: 12px; color: #2F6B3F; font-weight: 700; }
	.empty-card { background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 14px; padding: 18px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; }
	.sec-title { display: block; color: #8C9689; font-size: 11px; font-weight: 700; letter-spacing: .2em; margin: 18px 2px 8px; }
	/* ---------- 订单徽章/操作 ---------- */
	.order-cancel { opacity: .55; }
	.oc-meal { border-radius: 7px; padding: 2px 8px; font-size: 10.5px; font-weight: 700; margin-left: 8px; }
	.meal-lunch { background-color: #E9F1E7; color: #2F6B3F; }
	.meal-dinner { background-color: #1D4226; color: #E9F1E7; }
	.oc-status { border-radius: 7px; padding: 3px 9px; font-size: 11px; font-weight: 700; }
	.st-pending { background-color: #F3F7F1; color: #2F6B3F; }
	.st-cooking { background-color: #1D4226; color: #E9F1E7; }
	.st-ready { background-color: #E9F1E7; color: #2F6B3F; }
	.st-delivered { background-color: #2F6B3F; color: #FFFFFF; }
	.st-cancel { background-color: #E7E3D6; color: #8C9689; }
	.oc-note { display: block; color: #24522F; font-size: 12px; margin-top: 5px; }
	.oc-logtime { display: block; font-family: monospace; font-size: 11px; color: #8C9689; margin-top: 6px; }
	.act { height: 40px; border-radius: 11px; font-size: 13.5px; font-weight: 700; margin: 0; padding: 0; line-height: 38px; }
	.act-main { flex: 1; background-color: #2F6B3F; background-image: linear-gradient(180deg, #2F6B3F, #24522F 55%, #1D4226); color: #FFFFFF; border: 0; box-shadow: 0 4px 10px rgba(47,107,63,.28); }
	.act-main[disabled] { background-color: #E7E3D6; background-image: none; box-shadow: none; color: #8C9689; }
	.act-cancel { width: 86px; background-color: #FFFFFF; border: 1px solid #E7E3D6; color: #8C9689; margin-left: 9px; }
	.act-mini { height: 32px; border-radius: 9px; font-size: 12px; font-weight: 700; line-height: 30px; padding: 0 12px; margin: 0; }
	.act-mini-main { background-color: #2F6B3F; color: #FFFFFF; border: 0; margin-right: 8px; box-shadow: 0 3px 8px rgba(47,107,63,.25); }
	.act-mini-main[disabled] { background-color: #E7E3D6; background-image: none; box-shadow: none; color: #8C9689; }
	.act-mini-ghost { background-color: #FFFFFF; border: 1px solid #E7E3D6; color: #24522F; margin-right: 8px; }
	.act-mini-cancel { background-color: #FFFFFF; border: 1px solid #E7E3D6; color: #8C9689; }
	/* ---------- 配送管理 ---------- */
	.deliv-card { background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 14px; padding: 12px 14px; margin-bottom: 10px; display: flex; flex-direction: row; align-items: center; box-shadow: 0 4px 10px rgba(34,48,31,.04); }
	.deliv-info { flex: 1; }
	.deliv-locrow { display: flex; flex-direction: row; align-items: center; }
	.deliv-loc { font-size: 15px; font-weight: 800; color: #22301F; }
	.deliv-badge { border-radius: 7px; padding: 3px 9px; font-size: 11px; font-weight: 700; margin-left: 8px; }
	.deliv-badge-ready { background-color: #F3F7F1; color: #2F6B3F; }
	.deliv-badge-doing { background-color: #1D4226; color: #E9F1E7; }
	.deliv-badge-done { background-color: #24522F; color: #F6F3EB; }
	.deliv-meta { display: block; font-family: monospace; font-size: 12px; color: #8C9689; margin-top: 5px; }
	.act-deliver { width: 96px; height: 40px; background-color: #2F6B3F; background-image: linear-gradient(180deg, #2F6B3F, #24522F); color: #FFFFFF; border: 0; border-radius: 11px; font-size: 13px; font-weight: 700; line-height: 40px; padding: 0; margin: 0; box-shadow: 0 4px 10px rgba(47,107,63,.28); }
	.act-deliver-done { background-image: linear-gradient(180deg, #24522F, #1D4226); }
	.act-deliver[disabled] { background-color: #E7E3D6; background-image: none; box-shadow: none; color: #8C9689; }
	/* ---------- 菜单管理 ---------- */
	.act-add { height: 34px; background-color: #2F6B3F; color: #FFFFFF; border: 0; border-radius: 999px; font-size: 12.5px; font-weight: 700; line-height: 34px; padding: 0 14px; margin: 0; box-shadow: 0 4px 10px rgba(47,107,63,.25); }
	.pill-row { display: flex; flex-direction: row; align-items: center; }
	.pill { padding: 7px 14px; border-radius: 999px; background-color: #FFFFFF; border: 1px solid #E7E3D6; margin-right: 8px; }
	.pill-on { background-color: #2F6B3F; border-color: #2F6B3F; }
	.pill-text { font-size: 12.5px; color: #24522F; font-weight: 600; }
	.pill-text-on { color: #FFFFFF; }
	.menu-date-hint { display: block; font-family: monospace; font-size: 11px; color: #8C9689; margin-top: 8px; }
	.dish-card { background-color: #FFFFFF; border: 1px solid #E7E3D6; border-radius: 14px; padding: 11px 13px; margin-top: 10px; box-shadow: 0 4px 10px rgba(34,48,31,.04); }
	.dish-off { opacity: .55; }
	.dish-row { display: flex; flex-direction: row; align-items: center; }
	.dish-img { width: 44px; height: 44px; border-radius: 10px; background-color: #E7E3D6; }
	.dish-info { flex: 1; margin-left: 10px; }
	.dish-name { font-size: 14.5px; font-weight: 700; color: #22301F; }
	.dish-meta { display: flex; flex-direction: row; align-items: center; margin-top: 5px; }
	.dish-badge { font-size: 10.5px; border-radius: 6px; padding: 2px 7px; font-weight: 700; }
	.dish-badge-on { background-color: #E9F1E7; color: #2F6B3F; }
	.dish-badge-off { background-color: #E7E3D6; color: #8C9689; }
	.dish-right { display: flex; flex-direction: column; align-items: flex-end; }
	.dish-price { font-family: monospace; font-size: 14px; font-weight: 800; color: #2F6B3F; }
	.dish-edit { font-size: 11px; color: #8C9689; font-weight: 600; border: 1px solid #E7E3D6; border-radius: 999px; padding: 3px 9px; margin-top: 6px; }
	.dish-ops { display: flex; flex-direction: row; margin-top: 9px; border-top: 1px dashed #E7E3D6; padding-top: 9px; }
	.dc-cat { font-size: 11px; color: #8C9689; border: 1px solid #E7E3D6; border-radius: 6px; padding: 2px 7px; }
	.dc-op { padding: 5px 12px; background-color: #F3F7F1; border-radius: 8px; margin-right: 8px; }
	.dc-op-text { font-size: 12px; color: #24522F; font-weight: 600; }
	.dc-op-del { color: #24522F; font-weight: 700; }
